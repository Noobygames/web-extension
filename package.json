{
  "name": "ogame-beyond-infinity",
  "version": "1.0.0",
  "description": "This extension provides a set additional features for OGame.",
  "main": "src/main.js",
  "scripts": {
    "test": "node --experimental-test-module-mocks --test \"test/**/*.test.js\"",
    "test:watch": "node --experimental-test-module-mocks --test --watch \"test/**/*.test.js\"",
    "coverage": "node --experimental-test-module-mocks --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-exclude=\"scripts/**\" \"test/**/*.test.js\"",
    "bench": "node scripts/bench.mjs",
    "format": "prettier --write \"src/**/*.js\" \"test/**/*.js\" \"scripts/*.mjs\"",
    "check": "eslint \"src/**/*.js\" \"test/**/*.js\" \"scripts/*.mjs\""
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Noobygames/web-extension.git"
  },
  "keywords": [
    "ogame",
    "infinity",
    "features",
    "plugin",
    "extension",
    "chrome",
    "edge",
    "browser"
  ],
  "author": "Nerzal",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Noobygames/web-extension/issues"
  },
  "homepage": "https://github.com/Noobygames/web-extension#readme",
  "devDependencies": {
    "clean-css": "^5.3.2",
    "clean-css-cli": "^5.6.2",
    "eslint": "^8.47.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.28.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jsdom": "^24.1.3",
    "prettier": "3.0.2",
    "rollup": "^4.63.0",
    "terser": "^5.19.4"
  },
  "type": "module"
}
