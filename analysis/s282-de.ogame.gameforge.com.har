isabled a,\n#empireComponent .no-touch .middleSliderArrows div.anythingSlider .forward.disabled a:hover,\n#empireComponent .middleSliderArrows div.anythingSlider .forward.disabled a.hover { background-position:  -88px -310px; }\n#empireComponent .middleSliderArrows div.anythingSlider .forward a                { background-position: -118px -310px; }\n#empireComponent .no-touch .middleSliderArrows div.anythingSlider .forward a:hover,\n#empireComponent .middleSliderArrows div.anythingSlider .forward a.hover          { background-position:  -148px -310px; }\n\n#empireComponent .hovered {\n    background: #212a33 !important;\n}\n\n#empire div#resources {\n    display: block;\n}\n\n.errorBox {\n    position: relative;\n    z-index: 999;\n}\n\ndiv#eventCountdownBox {\n    background-image: url(\"//gf2.geo.gfsrv.net/cdn4a/94d57b85e6466e43839b19bbe8dae9.png\");\n    background-position: 155px -40px;\n    background-size: 96%;\n    border-radius: 8px;\n    box-shadow: black 1px 1px 7px 1px;\n    margin-bottom: 8px;\n}\n\ndiv#eventCountdownBox a {\n    color: white;\n    text-decoration: none;\n    font: 11px Verdana,Arial,Helvetica,sans-serif;\n    width: 150px;\n    height: 120px;\n    display: flex;\n    -webkit-border-radius: 5px; /* Saf3-4, iOS 1-3.2, Android ≤1.6 */\n    -moz-border-radius: 5px; /* FF1-3.6 */\n    border-radius: 5px; /* Opera 10.5, IE9, Saf5, Chrome, FF4, iOS 4, Android 2.1+ */\n    padding: 5px;\n    align-items: center;\n    text-align: center;\n    flex-direction: column;\n    justify-content: space-between;\n}\n\ndiv#eventCountdownBox a #eventCountdown {\n    display: flex;\n    font-size: 18px;\n    text-shadow: #000000b0 3px -4px 4px;\n}\n\ndiv#eventCountdownBox a #eventCountdownButton {\n    padding: 0.6em 2em;\n    border: none;\n    outline: none;\n    color: rgb(255, 255, 255);\n    background: #111;\n    cursor: pointer;\n    position: relative;\n    z-index: 0;\n    border-radius: 10px;\n    user-select: none;\n    -webkit-user-select: none;\n    touch-action: manipulation;\n    font-weight: bold;\n}\n\ndiv#eventCountdownBox a #eventCountdownButton:before {\n    content: \"\";\n    background: linear-gradient(\n            45deg,\n            rgba(255, 255, 255, 0.65),\n            #3b2381bf,\n            #6F9FC8,\n            #767f88,\n            #322e81,\n            #a06cf8\n    );\n    position: absolute;\n    top: -2px;\n    left: -2px;\n    background-size: 250%;\n    z-index: -1;\n    filter: blur(5px);\n    -webkit-filter: blur(5px);\n    width: calc(100% + 1px);\n    height: calc(100% + 1px);\n    animation: glowing-button 30s linear infinite;\n    transition: opacity 0.3s ease-in-out;\n    border-radius: 10px;\n}\n\n@keyframes glowing-button {\n    0% {\n        background-position: 0 0;\n    }\n    50% {\n        background-position: 350% 0;\n    }\n    100% {\n        background-position: 0 0;\n    }\n}\n\ndiv#eventCountdownBox a #eventCountdownButton:after {\n    z-index: -1;\n    content: \"\";\n    position: absolute;\n    width: 100%;\n    height: 100%;\n    background: #3b2381bf;\n    left: 0;\n    top: 0;\n    border-radius: 10px;\n}\n\ndiv#eventCountdownBox a #eventCountdownButton:hover {\n    filter: brightness(120%);\n}\n\n/* ************************* Eventlist ************************************** */\n\n.eventFleet td,\n.allianceAttack td {\n    font-size: 11px;\n    padding: 1px 0;\n}\n.detailsFleet {\n    width: 55px;\n}\n\n#eventContent {\n    background: transparent url(\"//gf1.geo.gfsrv.net/cdn9e/4f73643e86a952be4aed7fdd61805a.gif\") 5px 0px  repeat-y;\n    width: 100%;\n    margin: 0;\n    padding: 5px 10px 0 10px;\n    text-align: center;\n    border-spacing: 0;\n}\n\n#eventContent .originFleet span,\n#eventContent .destFleet span {\n    overflow: hidden;\n    width: 110px;\n    text-overflow: ellipsis;\n    display: inline-block;\n    white-space: nowrap;\n}\n\n#eventFooter {\n    background: transparent url(\"//gf1.geo.gfsrv.net/cdn30/aa3e8edec0a2681915b3c9c6795e6f.gif\"