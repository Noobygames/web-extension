ast,\n#messages .tabsWrapper .innerTabItem.active {\n    background-image:  url(\"//gf3.geo.gfsrv.net/cdne1/d03835718066a5a592a6426736e019.png\");\n}\n\n#messages .tabsWrapper .innerTabItem.first,\n .tabsWrapper .innerTabItem.last {\n    background-repeat: no-repeat;\n    position: relative;\n}\n#messages .tabsWrapper .innerTabItem.first {\n    background-position: 0 -255px;\n    left: -3px;\n}\n\n#messages .tabsWrapper .innerTabItem.last {\n    background-position: 100% -285px;\n    right: -3px;\n}\n\n#messages .tabsWrapper .innerTabItem.active,\n#messages .tabsWrapper .innerTabItem.first.active,\n#messages .tabsWrapper .innerTabItem.last.active,\n#messages .tabsWrapper .innerTabItem:hover,\n#messages .tabsWrapper .innerTabItem.first:hover,\n#messages .tabsWrapper .innerTabItem.last:hover {\n    color: #fff;\n    background-image:  url(\"//gf3.geo.gfsrv.net/cdne1/d03835718066a5a592a6426736e019.png\");\n    background-repeat: repeat-x;\n    background-position: 0 -315px;\n}\n\n#messages .tabsWrapper .innerTabItem.first.active:before {\n    content: \"\";\n    top: 0;\n    left: 0;\n    position: absolute;\n    background-image:  url(\"//gf3.geo.gfsrv.net/cdne1/d03835718066a5a592a6426736e019.png\");\n    background-repeat: no-repeat;\n    background-position: 0 -345px;\n    width: 100%;\n    height: 28px;\n}\n\n\n/* ***************** second level tab navigation inside a page ************** */\n\n\n\n.no-touch .subtabs .ui-state-hover,\n.subtabs .ui-tabs-active {\n    color: #fff;\n    background-repeat: repeat-x;\n    background-position: 0 -315px;\n    text-decoration: none;\n}\n.subtabs .first .txt_link,\n.subtabs .last .txt_link {\n    background-repeat: no-repeat;\n    position: relative;\n}\n\n.subtabs .first .txt_link {\n    background-position: 0 -255px;\n    left: -3px;\n}\n.subtabs .last .txt_link {\n    background-position: 100% -285px;\n    right: -3px;\n}\n\n.subtabs .ui-tabs-active.first .txt_link { background-position: 0 -345px; }\n.ui-tabs-active.last 