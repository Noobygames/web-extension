.jpg\");\n}\nprofile-picture.S10_A1_T5_Ava_ID1 {\n    background-image: url(\"//gf2.geo.gfsrv.net/cdn13/b099b1fae69c79229e3312c5f7af2f.jpg\");\n}\nprofile-picture.S10_A2_T5_Ava_ID2 {\n    background-image: url(\"//gf1.geo.gfsrv.net/cdn3a/09274158bf5f6b3232f03b309df0b8.jpg\");\n}\nprofile-picture.S10_A3_T5_Ava_ID3 {\n    background-image: url(\"//gf3.geo.gfsrv.net/cdnec/7fc87b1d913f96af985e49c6192f4e.jpg\");\n}\nprofile-picture.S10_A10_T5_Ava_ID4 {\n    background-image: url(\"//gf1.geo.gfsrv.net/cdn64/e25e9aefb3f416b298ce52bc327c73.jpg\");\n}\nprofile-picture.S10_A13_T5_Ava_ID5 {\n    background-image: url(\"//gf3.geo.gfsrv.net/cdne0/b8ffd621969f83936a1d845c291e6f.jpg\");\n}\nprofile-picture.S10_A15_T5_Ava_ID6 {\n    background-image: url(\"//gf1.geo.gfsrv.net/cdnf9/cf9ff9894fedee4d008d97f97392e5.jpg\");\n}\n/* avatars end */\n\n/* space object skins */\nspace-object-skin {\n    display: inline-block;\n    height: 50px;\n    width: 50px;\n    border-radius: 4px;\n}\n\nspace-object-skin img {\n    display: inline-flex;\n    height: 100%;\n    width: 100%;\n    border-radius: 4px;\n}\n/* space object skins */\n\n/* lifeformicon start */\nlifeformicon {\n    display: inline-block;\n}\n\nlifeformicon[bordered] {\n    border-radius: 5px;\n}\n\nlifeformicon .lifeform-item-icon {\n    background: url(\"//gf2.geo.gfsrv.net/cdna5/5681003b4f1fcb30edc5d0e62382a2.png\") no-repeat 0 0;\n}\nlifeformicon .lifeform-item-icon {\n    width: var(--var-width);\n    height: var(--var-height);\n    --base-width: 77;\n    --base-height: 76;\n    --var-width: 77px;\n    --var-height: 76px;\n    margin-top: 1px;\n    background-size: calc(var(--var-width) / var(--base-width) * 100%) calc(var(--var-height) / var(--base-height) * 100%);\n}\n\nlifeformicon .lifeform-item-icon.lifeform1,\nlifeformicon .lifeform-item-icon.lifeform2,\nlifeformicon .lifeform-item-icon.lifeform3,\nlifeformicon .lifeform-item-icon.lifeform4 {\n    background-position-y: -200px;\n}\nlifeformicon .lifeform-item-icon.lifeform1 {\n    background-position-x: 0;\n}\nlifeformicon .lifeform-item-icon.lifeform2 {\n    background-position-x: -78px;\n}\nlifeformicon .lifeform-item-icon.lifeform3 {\n    background-position-x: -156px;\n}\nlifeformicon .lifeform-item-icon.lifeform4 {\n    background-position-x: -234px;\n}\n/* lifeformicon end */\n\n/* officer-icon start */\nofficer-icon {\n    display: inline-block;\n    filter: grayscale(1) brightness(50%);\n}\n\nofficer-icon[bordered] {\n    border-radius: 5px;\n}\nofficer-icon[selected] {\n    filter: grayscale(0);\n}\n\nofficer-icon.halloween {\n    background: url(\"//gf3.geo.gfsrv.net/cdnbe/573e9fe7841ca98c945a16f00138fb.png\") no-repeat 0 0;\n}\nofficer-icon.officer-item-icon {\n    background: url(\"//gf2.geo.gfsrv.net/cdn41/a22e8a59e7cfd08f0997cf491c2ca1.png\") no-repeat 0 0;\n}\n\nofficer-icon.officer-item-icon {\n    width: var(--var-width);\n    height: var(--var-height);\n    --var-width: 100px;\n    --var-height: 100px;\n    --sprite-columns: 7;\n    --index: 0; /* Default */\n\n    /* Scale sprite sheet */\n    background-size: calc(var(--sprite-columns) * 100%) auto;\n    background-repeat: no-repeat;\n\n    /* Dynamically position based on column index */\n    background-position-x: calc(var(--index) * 100% / (var(--sprite-columns) - 1));\n    background-position-y: 0;\n}\nofficer-icon.officer-item-icon.darkMatter { --index: 0; }\nofficer-icon.officer-item-icon.officerCommander { --index: 1; }\nofficer-icon.officer-item-icon.officerAdmiral { --index: 2; }\nofficer-icon.officer-item-icon.officerEngineer { --index: 3; }\nofficer-icon.officer-item-icon.officerGeologist { --index: 4; }\nofficer-icon.officer-item-icon.officerTechnocrat { --index: 5; }\nofficer-icon.officer-item-icon.officerAll { --index: 6; }\n\n/*officer-icon.officer-item-icon.darkMatter,*/\n/*officer-icon.officer-item-icon.officerCommander,*/\n/*officer-icon.officer-item-icon.officerAdmiral,*/\n/*officer-icon.officer-item-icon.officerEngineer,*/\n/*officer-icon.officer-item-icon.officerGeologist,*/\n/*officer-icon.officer-item-icon.officerTechnocrat,*/\n/*officer-icon.officer-item-icon.officerAll {*/\n/*    background-position-y: 0;*/\n/*}*/\n/*officer-icon.officer-item-icon.darkMatter {*/\n/*    background-position-x: 0;*/\n/*}*/\n/*officer-icon.officer-item-icon.officerCommander {*/\n/*    background-position-x: -100px;*/\n/*}*/\n/*officer-icon.officer-item-icon.officerAdmiral {*/\n/*    background-position-x: -200px;*/\n/*}*/\n/*officer-icon.officer-item-icon.officerEngineer {*/\n/*    background-position-x: -300px;*/\n/*}*/\n/*officer-icon.officer-item-icon-icon.officerGeologist {*/\n/*    background-position-x: -400px;*/\n/*}*/\n/*officer-icon.officer-item-icon.officerTechnocrat {*/\n/*    background-position-x: -500px;*/\n/*}*/\n/*officer-icon.officer-item-icon.officerAll {*/\n/*    background-position-x: -600px;*/\n/*}*/\n/* officer-icon end */\n\n/* change all scrollbars in OGame*/\n::-webkit-scrollbar {\n    width: 8px;\n}\n\n::-webkit-scrollbar-track {\n    background: #5E798A;\n}\n\n::-webkit-scrollbar-thumb {\n    background: #2E4456;\n}\n\n::-webkit-scrollbar-thumb:hover {\n    background: #435B6D;\n}\n\n/***\n    General section\n */\n*[sq12] {\n    width: 12px !important;\n    height: 12px !important;\n    --var-width: 12 !important;\n    --var-height: 12 !important;\n}\n*[sq16] {\n    width: 16px !important;\n    height: 16px !important;\n    --var-width: 16 !important;\n    --var-height: 16 !important;\n}\n*[sq20] {\n    width: 20px !important;\n    height: 20px !important;\n    --var-width: 20 !important;\n    --var-height: 20 !important;\n}\n*[sq22] {\n    width: 22px !important;\n    height: 22px !important;\n    --var-width: 22 !important;\n    --var-height: 22 !important;\n}\n*[sq24] {\n    width: 24px !important;\n    height: 24px !important;\n    --var-width: 24 !important;\n    --var-height: 24 !important;\n}\n*[sq26] {\n    width: 26px !important;\n    height: 26px !important;\n    --var-width: 26 !important;\n    --var-height: 26 !important;\n}\n*[sq28] {\n    width: 28px !important;\n    height: 28px !important;\n    --var-width: 28 !important;\n    --var-height: 28 !important;\n}\n*[sq30] {\n    width: 30px !important;\n    height: 30px !important;\n    --var-width: 30 !important;\n    --var-height: 30 !important;\n}\n*[sq36] {\n    width: 36px !important;\n    height: 36px !important;\n    --var-width: 36 !important;\n    --var-height: 36 !important;\n}\n*[sq40] {\n    width: 40px !important;\n    height: 40px !important;\n    --var-width: 40 !important;\n    --var-height: 40 !important;\n}\n*[sq44] {\n    width: 44px !important;\n    height: 44px !important;\n    --var-width: 44 !important;\n    --var-height: 44 !important;\n}\n*[sq50] {\n    width: 50px !important;\n    height: 50px !important;\n    --var-width: 50 !important;\n    --var-height: 50 !important;\n}\n*[sq55] {\n    width: 55px !important;\n    height: 55px !important;\n    --var-width: 55 !important;\n    --var-height: 55 !important;\n}\n*[sq70] {\n    width: 70px !important;\n    height: 70px !important;\n    --var-width: 70 !important;\n    --var-height: 70 !important;\n}\n*[sq100] {\n    width: 100px !important;\n    height: 100px !important;\n    --var-width: 100 !important;\n    --var-height: 100 !important;\n}\n*[sq180] {\n    width: 180px !important;\n    height: 180px !important;\n    --var-width: 180 !important;\n    --var-height: 180 !important;\n}\n*[sq200] {\n    width: 200px !important;\n    height: 200px !important;\n    --var-width: 200 !important;\n    --var-height: 200 !important;\n}\n*[w50] {\n    width: 50px !important;\n    --var-width: 50 !important;\n}\n*[w60] {\n    width: 60px !important;\n    --var-width: 60 !important;\n}\n*[w70] {\n    width: 70px !important;\n    --var-width: 70 !important;\n}\n*[w80] {\n    width: 80px !important;\n    --var-width: 80 !important;\n}\n*[w100] {\n    width: 100px !important;\n    --var-width: 100 !important;\n}\n*[w105] {\n    width: 105px !important;\n    --var-width: 105 !important;\n}\n*[w110] {\n    width: 110px !important;\n    --var-width: 110 !important;\n}\n*[w115] {\n    width: 115px !important;\n    --var-width: 115 !important;\n}\n*[w120] {\n    width: 120px !important;\n    --var-width: 120 !important;\n}\n*[w140] {\n    width: 140px !important;\n    --var-width: 140 !important;\n}\n*[w150] {\n    width: 150px !important;\n    --var-width: 150 !important;\n}\n*[w160] {\n    width: 160px !important;\n    --var-width: 160 !important;\n}\n*[w200] {\n    width: 200px !important;\n    --var-width: 200 !important;\n}\n*[h16] {\n    height: 16px !important;\n    --var-height: 16 !important;\n}\n*[h18] {\n    height: 18px !important;\n    --var-height: 18 !important;\n}\n*[h20] {\n    height: 20px !important;\n    --var-height: 20 !important;\n}\n*[h22] {\n    height: 22px !important;\n    --var-height: 22 !important;\n}\n*[h24] {\n    height: 24px !important;\n    --var-height: 24 !important;\n}\n*[h26] {\n    height: 26px !important;\n    --var-height: 26 !important;\n}\n*[h28] {\n    height: 28px !important;\n    --var-height: 28 !important;\n}\n*[h50] {\n    height: 50px !important;\n    --var-height: 50 !important;\n}\n\n#defense header {\n    position: relative;\n    width: 654px;\n    height: 250px;\n    margin: 0 auto 8px;\n    background: url(\"//gf2.geo.gfsrv.net/cdna2/90f5ba1a698a8c5a6155717f3072df.jpg\");\n}\n\n#defense header::after {\n    position: absolute;\n    left: -8px;\n    bottom: -2px;\n    width: 670px;\n    height: 39px;\n    background: url(\"//gf3.geo.gfsrv.net/cdn8b/e7a3f8489bd4c9c45d14851020c656.gif\") bottom left no-repeat, url(\"//gf2.geo.gfsrv.net/cdnd8/7c3b7bb7038a638e9c122542398514.gif\") bottom right no-repeat ;\n    content: \"\";\n}\n\n#defense header h2 {\n    position: absolute;\n    left: 144px;\n    top: 7px;\n    font: bold 18px/22px Verdana,Arial,Helvetica,sans-serif;\n    color: #fff;\n}\n\n#defense #technologies {\n    position: relative;\n    box-sizing: border-box;\n    width: 654px;\n    border: 2px solid #000;\n    margin: 0 auto 7px;\n    padding: 0 5px;\n    background: #0d1014;\n}\n\n#defense #technologies::before,\n#defense #technologies::after {\n    pointer-events: none;\n}\n\n#defense #technologies::before {\n    position: absolute;\n    left: -9px;\n    top: -3px;\n    width: 668px;\n    height: 28px;\n    background: url(\"//gf3.geo.gfsrv.net/cdn53/f333e15eb738b8ec692340f507e1ae.png\") bottom left no-repeat, url(\"//gf2.geo.gfsrv.net/cdnd5/66551209db14e23b3001901b996cc6.png\") bottom right no-repeat;\n    content: \"\";\n}\n\n#defense #technologies::after {\n    position: absolute;\n    left: -9px;\n    bottom: -4px;\n    width: 668px;\n    height: 50px;\n    background: url(\"//gf3.geo.gfsrv.net/cdnea/0330abcdca0d125d35a0ebace4b584.png\") bottom left no-repeat, url(\"//gf1.geo.gfsrv.net/cdn9b/8003a40825bc96919c5fec01b018b8.png\") bottom right no-repeat;\n    content: \"\";\n}\n\n#defense #technologies h3 {\n    position: relative;\n    width: 100%;\n    margin: -2px 0 5px;\n    background: url(\"//gf1.geo.gfsrv.net/cdnfb/a4e7913209228ebaf2297429aeb87b.png\");\n    color: #6f9fc8;\n    font: bold 12px/27px Verdana,Arial,Helvetica,sans-serif;\n    text-align: center;\n}\n\n#defense #technologies h3::before,\n#defense #technologies h3::after {\n    position: absolute;\n    top: 0;\n    width: 26px;\n    height: 27px;\n    content: \"\";\n}\n\n#defense #technologies h3::before {\n    left: -5px;\n    background: url(\"//gf2.geo.gfsrv.net/cdn4a/127bd495b9325216af08a588ecc540.png\");\n}\n\n#defense #technologies h3::after {\n    right: -5px;\n    background: url(\"//gf2.geo.gfsrv.net/cdn1d/80db96934a5b82ce002f839cd85a44.png\");\n}\n\n#defense #technologies .icons {\n    display: flex;\n    flex-flow: row wrap;\n    justify-content: space-between;\n    margin-bottom: 7px;\n}\n\n#defense #technologies .icons::after {\n    display: inline-block;\n    content: \"\";\n    width: 208px;\n}\n\n#defense #technologies.moon .icons::after {\n    width: 425px;\n}\n\n.emoji {\n    background: url(\"//gf1.geo.gfsrv.net/cdnc8/5a565a8596ded258f57ed2e1c66027.png\");\n    height: 20px;\n    width: 20px;\n    display: inline-block;\n    margin: 0 4px 0 0;\n}\n.emoji.deactivated {\n    background-position: -280px -360px;\n}\n.emoji.activated {\n    background-position: -300px -360px;\n}\n.emoji.smile {\n    background-position: -420px -380px;\n}\n.emoji.lol {\n    background-position: -320px -260px;\n}\n.emoji.angry {\n    background-position: -540px -140px;\n}\n.emoji.sad {\n    background-position: -320px -240px;\n}\n.emoji.sleep {\n    background-position: 0 -320px;\n}\n.emoji.sos {\n    background-position: -40px 0;\n}\n.emoji.cool {\n    background-position: -320px 0;\n}\n.emoji.moon {\n    background-position: 0 -80px;\n}\n.emoji.kiss {\n    background-position: -540px -180px;\n}\n.emoji.coffee {\n    background-position: -420px -40px;\n}\n.emoji.cry {\n    background-position: -540px -40px;\n}\n.emoji.angel {\n    background-position: -420px -220px;\n}\n.emoji.skull {\n    background-position: -440px -160px;\n}\n.emoji.mad {\n    background-position: -320px -160px;\n}\n.emoji.eyes {\n    background-position: -540px -200px;\n}\n.emoji.pray {\n    background-position: -540px -280px;\n}\n.emoji.alarm {\n    background-position: -100px -340px;\n}\n.emoji.thumbup {\n    background-position: -160px -380px;\n}\n.emoji.thumbdown {\n    background-position: -540px -360px;\n}\n.emoji.poo {\n    background-position: -40px -420px;\n}\n.emoji.present {\n    background-position: -400px -420px;\n}\n.emoji.rocket {\n    background-position: -300px -420px;\n}\n.emoji.ghost {\n    background-position: -440px -140px;\n}\n.emoji.win {\n    background-position: -320px -420px;\n}\n.emoji.sheep {\n    background-position: -140px -180px;\n}\n.emoji.warningsign {\n    background-position: -500px -220px;\n}\n.emoji.leader {\n    background-position: -320px -420px;\n}\n.emoji.trash {\n    background-position: -180px -340px;\n}\n\n#empireComponent {\n\n    color:#f1f1f1;\n    font: 100 11px Verdana, Arial, SunSans-Regular, Sans-Serif;\n    /*\theight:101%; */\n    height:100%;\n}\n\n#empireComponent #mainContent {\n    margin: 0 auto;\n    width: 1000px;\n}\n\n#empireComponent #empireTab {\n    color:#f1f1f1;\n    height: 35px;\n    line-height:35px;\n}\n\n\n#empireComponent #mainWrapper {\n    margin: 0 auto;\n    padding:30px 0 50px;\n    min-width: 840px;\n    font-size: 11px;\n}\n\n#empireComponent #loading { margin-top: -50px;}\n\n#empireComponent .header {\n    float: left;\n    width: 180px;\n    margin: 0;\n    padding:15px 0 0 0;\n    color:#ffffff;\n}\n\n#empireComponent .planetWrapper {\n    padding: 0;\n    margin: 0;\n}\n\n#empireComponent .planet {\n    float:left;\n    margin:0;\n    width:165px;\n}\n\n#empireComponent .move {\n    cursor: move;\n}\n\n#empireComponent .clearfloat {\n    /* this class should be placed on a div or break element\n    and should be the final element before the close of\n    a container that should fully contain a float */\n    clear:both;\n    height:0;\n    font-size: 1px;\n    line-height: 0;\n}\n\n\n#empireComponent .textCenter { text-align:center;}\n#empireComponent .textLeft { text-align:left;}\n#empireComponent .textRight { text-align:right;}\n\n#empireComponent .planetname {\n    color:#A26D00;\n    font-size:11px;\n    height:24px;\n    line-height:24px;\n    text-align:center;\n    width:145px;\n    margin:0 auto;\n    white-space:nowrap;\n    overflow:hidden;\n}\n\n#empireComponent .planetImg {\n    margin:4px auto 0;\n    width:156px;\n    overflow:hidden;\n    background-position: center;\n    background-repeat: no-repeat;\n    background-size: cover;\n}\n\n#empireComponent .planetData {\n    padding:0 5px;\n    line-height:26px;\n    height:77px;\n    color:#848484;\n    position: relative;\n}\n\n#empireComponent .planetData div {\n    height: 24px;\n    padding-left: 4px;\n}\n\n#empireComponent .no-touch .planetData:hover { cursor:move;}\n\n#empireComponent .planetData a:link {\n    color:#848484;\n    text-decoration:none;\n}\n\n#empireComponent .planetDataTop li{\n    float:left;\n    width:70px;\n}\n\n/* Energy row: the label length varies per language and the value can be long\n * (e.g. \"-22.231.605\" on a heavily negative balance), so the two fixed 70px\n * cells above don't work here. Lay the row out with flex instead — the label\n * keeps its natural width whatever the translation, the value takes whatever\n * is left and clips rather than wrapping. Without this the value wrapped\n * inside its 70px cell and, since the row is pinned to 24px, the second line\n * painted on top of the temperature row below it. The full breakdown stays\n * reachable through the row's existing tooltip. */\n#empireComponent .planetDataTop.energyRow ul {\n    display: flex;\n}\n\n#empireComponent .planetDataTop.energyRow li {\n    float: none;\n    width: auto;\n    white-space: nowrap;\n}\n\n#empireComponent .planetDataTop.energyRow li.textLeft {\n    flex: 0 0 auto;\n    padding-right: 4px;\n}\n\n#empireComponent .planetDataTop.energyRow li.textRight {\n    flex: 1 1 auto;\n    min-width: 0;\n    overflow: hidden;\n}\n\n/* Reclaim the 4px that `.planetData div` adds to the nested tooltip wrapper. */\n#empireComponent .planetDataTop.energyRow li.textRight > div {\n    padding-left: 0;\n}\n\n#empireComponent .planetDataBottom li{\n    width:140px;\n    float: left;\n}\n\n#empireComponent .neutral {color: #FFFFFF;}\n\n#empireComponent .firstCat,\n#empireComponent h3 { text-align:left;}\n\n#empireComponent h2 {\n    font-size: 18px;\n    font-weight: 700;\n    padding-left:20px;\n    position:absolute;\n    top:0;\n    left:0;\n}\n\n#empireComponent .header h3 {\n    background: url(\"//gf1.geo.gfsrv.net/cdn33/48f9f2b022ed5310e29c6d138c04dd.gif\") no-repeat;\n    color: #576472;\n    display: block;\n    font-size: 12px;\n    font-weight: 700;\n    height: 28px;\n    line-height: 26px;\n    overflow:hidden;\n    width: 180px;\n    cursor: pointer;\n}\n\n\n#empireComponent h3.open {\tbackground-position: -88px -83px;}\n#empireComponent h3.openhover {\n    background-position: -88px -111px;\n    color: #6F9FC8;\n}\n#empireComponent h3.close {\tbackground-position: -88px -27px;}\n#empireComponent h3.closehover {\tbackground-position: -88px -55px;\n    color: #6F9FC8;\n}\n\n\n\n#empireComponent h3 span { padding-left:40px;}\n\n#empireComponent .secondCat { width:172px; margin-left:5px;}\n\n#empireComponent .catbox-end,\n#empireComponent .box-end {\n    border-bottom: 1px solid #000;\n    -moz-border-radius-bottomright: 10px;\n    -moz-border-radius-bottomleft: 10px;\n    -webkit-border-radius-bottomright: 10px;\n    -webkit-border-radius-bottomleft: 10px;\n}\n\n#empireComponent .secondCat li.catbox-end {\n    height: 24px;\n}\n\n#empireComponent .secondCat li {\n    background: #0d1014;\n    border-left: 1px solid #000;\n    border-right: 1px solid #000;\n    color:#fff;\n    display: block;\n    height: 23px;\n    line-height: 23px;\n    overflow:hidden;\n    text-align: left;\n    width: 170px;\n}\n\n#empireComponent .secondCat li span  { padding-left:15px;}\n\n\n\n#empireComponent div.values {\n    text-align: center;\n    margin:0 auto 1px;\n    width:158px;\n}\n\n#empireComponent div.values div.even,\n#empireComponent div.values div.odd {\n    background:#0d1014 url(\"//gf3.geo.gfsrv.net/cdnbc/93c3e0cb04b4dd9e0ed5c331690c81.gif\") center no-repeat;\n    border-left: 1px solid #000;\n    border-right: 1px solid #000;\n    height: 23px;\n    line-height: 23px;\n    overflow:hidden;\n}\n\n\n#empireComponent div.values div.odd { background:#0d1014 none;}\n\n#empireComponent div.values .box-end { height:22px;}\n\n#empireComponent div.row {\n    background: url(\"//gf2.geo.gfsrv.net/cdn42/f5cbcd1ce792c000c5f40dcf657b33.gif\") center no-repeat;\n    height: 28px;\n    margin: 0 auto;\n    width: 164px;\n}\n\n#empireComponent .planetHead {\n    background: url(\"//gf1.geo.gfsrv.net/cdn0d/2a79578123dfab859b1440d465bf6b.gif\") 0 0 no-repeat;\n    width: 158px;\n    margin: 0 auto;\n    margin-bottom: 1px;\n}\n\n\n#empireComponent a.save {\n    background: url(\"//gf1.geo.gfsrv.net/cdn33/48f9f2b022ed5310e29c6d138c04dd.gif\") 0 0 no-repeat;\n    border: 0 none;\n    color:#0c0c0c;\n    cursor: pointer;\n    display:block;\n    font-size: 10px;\n    font-weight: 700;\n    height: 27px;\n    line-height: 27px;\n    margin:0 auto;\n    overflow:hidden;\n    text-align:center;\n    text-decoration:none;\n    width:153px;\n}\n\n#empireComponent div.adjustable {\n    padding-left:5px;\n    padding-right:10px;\n}\n\n#empireComponent .no-touch a.save:hover { color:#fff;}\n\n#empireComponent .values a.save {\n    background: url(\"//gf1.geo.gfsrv.net/cdn33/48f9f2b022ed5310e29c6d138c04dd.gif\") 0 -27px no-repeat;\n    width:88px;\n}\n\n#empireComponent .secondCat li.set-end {padding-top:6px; height:40px;}\n#empireComponent .planet .values .set-end { height:40px; padding-top:5px;}\n\n\n#empireComponent div.values div.set-element { line-height:18px; padding: 5px 5px 5px 0; }\n#empireComponent .set-element span { float:left; width:50px; }\n\n\n#empireComponent .overmark {color:#fe0000;}\n#empireComponent .undermark {color:#00f200;}\n\n#empireComponent select:focus{border-color: transparent; outline:0 none; }\n\n#empireComponent .figures {\n    float:left;\n    height:23px;\n    line-height:23px;\n    width:90px;\n    overflow:hidden;\n}\n\n#empireComponent .ddown {\n    float:right;\n    width:50px;\n    padding-top:3px;\n}\n\n#empireComponent .planetData a:link,\n#empireComponent .planetData a:visited,\n#empireComponent .no-touch .planetData a:hover,\n#empireComponent .planetData a:active{\n    color:#6f9fC8;\n    text-decoration:none;\n}\n\n#empireComponent .no-touch .planetData a:hover { text-decoration:underline;}\n\n#empireComponent div.planetData div.odd {\n    background:#0d1014 url(\"//gf3.geo.gfsrv.net/cdnbc/93