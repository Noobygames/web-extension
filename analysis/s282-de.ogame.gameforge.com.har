using labelStyle, borderWidth and borderStyle.\n     * \tlabel - the label to paint.  May be a string or a function that returns a string.  Nothing will be painted if your label is null or your\n     *         label function returns null.  empty strings _will_ be painted.\n     * \tlocation - distance (as a decimal from 0 to 1 inclusive) marking where the label should sit on the connector. defaults to 0.5.\n     * \tid - optional id to use for later retrieval of this overlay.\n     * \t\n     */\n    jsPlumb.Overlays.Label = function(params) {\n        var self = this;\n        this.labelStyle = params.labelStyle || jsPlumb.Defaults.LabelStyle;\n        this.cssClass = this.labelStyle != null ? this.labelStyle.cssClass : null;\n        params.create = function() {\n            return document.createElement(\"div\");\n        };\n        jsPlumb.Overlays.Custom.apply(this, arguments);\n        this.type = \"Label\";\n\n        var label = params.label || \"\",\n            self = this,\n            labelText = null;\n\n        /*\n         * Function: setLabel\n         * sets the label's, um, label.  you would think i'd call this function\n         * 'setText', but you can pass either a Function or a String to this, so\n         * it makes more sense as 'setLabel'. This uses innerHTML on the label div, so keep\n         * that in mind if you need escaped HTML.\n         */\n        this.setLabel = function(l) {\n            label = l;\n            labelText = null;\n            self.clearCachedDimensions();\n            _update();\n            self.component.repaint();\n        };\n\n        var _update = function() {\n            if (typeof label == \"function\") {\n                var lt = label(self);\n                self.getElement().innerHTML = lt.replace(/\\r\\n/g, \"<br/>\");\n            }\n            else {\n                if (labelText == null) {\n                    labelText = label;\n                    self.getElement().innerHTML = labelText.replace