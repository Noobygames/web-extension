lder .achievementTierContainer .achievementTierContainerTitle:before,\n#achievementsOverviewList .achievementContentList.unlocks .achievementOverviewAchievementHolder .achievementTierContainer .achievementTierContainerTitle:before {\n    content: \"\";\n    display: block;\n    box-sizing: border-box;\n    margin-top: 6px;\n    border-top: solid 1px;\n    border-top-color: rgba(192, 192, 192, 0.15);\n    min-width: 10px;\n    height: 10px;\n    pointer-events: none;\n    box-shadow: inset 0 1px transparent;\n    margin-right: 4px;\n    border-left: solid 1px transparent;\n    border-radius: 4px 0;\n}\n\n.tippy-content .achievementOverviewAchievementHolder .achievementTierContainer.unlocked .achievementTierContainerTitle:before,\n#achievementsOverviewList .achievementContentList.unlocks .achievementOverviewAchievementHolder .achievementTierContainer.unlocked .achievementTierContainerTitle:before {\n    border-top-color: rgba(52, 115, 63, 0.75);\n}\n\n.tippy-content .achievementOverviewAchievementHolder.hidden .achievementTierContainer.unlocked .achievementTierContainerTitle:before,\n#achievementsOverviewList .achievementContentList.unlocks .achievementOverviewAchievementHolder.hidden .achievementTierContainer.unlocked .achievementTierContainerTitle:before {\n    border-top-color: #fdbb2d;\n}\n\n.tippy-content .achievementOverviewAchievementHolder .achievementTierContainer .achievementTierContainerTitle:after,\n#achievementsOverviewList .achievementContentList.unlocks .achievementOverviewAchievementHolder .achievementTierContainer .achievementTierContainerTitle:after {\n    content: \"\";\n    display: block;\n    box-sizing: border-box;\n    margin-top: 6px;\n    border-top: solid 1px;\n    border-top-color: rgba(192, 192, 192, 0.15);\n    min-width: 10px;\n    height: 10px;\n    pointer-events: none;\n    box-shadow: inset 0 1px transparent;\n    flex-grow: 1;\n    margin-left: 4px;\n    border-right: solid 1px transparent;\n    border-radius: 0 4px;\n}\n\n.tippy-content .achievementOverviewAchievementHolder .achievementTierContainer.unlocked .achievementTierContainerTitle:after,\n#achievementsOverviewList .achievementContentList.unlocks .achievementOverviewAchievementHolder .achievementTierContainer.unlocked .achievementTierContainerTitle:after {\n    border-top-color: rgba(52, 115, 63, 0.75);\n}\n\n.tippy-content .achievementOverviewAchievementHolder.hidden .achievementTierContainer.unlocked .achievementTierContainerTitle:after,\n#achievementsOverviewList .achievementContentList.unlocks .achievementOverviewAchievementHolder.hidden .achievementTierContainer.unlocked .achievementTierContainerTitle:after {\n    border-top-color: #fdbb2d;\n}\n\n.tippy-content .achievementOverviewAchievementHolder .achievementTierContainer .achievementTierContainerData,\n#achievementsOverviewList .achievementContentList.unlocks .achievementOverviewAchievementHolder .achievementTierContainer .achievementTierContainerData {\n    width: 100%;\n    min-height: 75px;\n    border: 1px solid rgba(80, 80, 80, 0.6);\n    background-color: rgba(0, 0, 0, 0.2);\n    border-radius: 6px;\n    border-top: transparent;\n    font-size: 11px;\n    color: #CFCBC2;\n    display: flex;\n    flex-direction: row;\n    padding: 10px;\n}\n\n.tippy-content .achievementOverviewAchievementHolder .achievementTierContainer.unlocked .achievementTierContainerData,\n#achievementsOverviewList .achievementContentList.unlocks .achievementOverviewAchievementHolder .achievementTierContainer.unlocked .achievementTierContainerData {\n    border-color: rgba(52, 115, 63, 0.75);\n    border-top: transparent;\n}\n\n.tippy-content .achievementOverviewAchievementHolder.hidden .achievementTierContainer.unlocked .achievementTierContainerData,\n#achievementsOverviewList .achievementContentList.unlocks .achievementOverviewAchievementHolder.hidden .achievementTierContainer.unlocked .achievementTierContainerData {\n    border-color: #fdbb2d;\n}\n\n.tippy-content .achievementOverviewAchievementHolder .achievementTierContainer .achievementTierContainerData .achievementTierStatus,\n#achievementsOverviewList .achievementContentList.unlocks .achievementOverviewAchievementHolder .achievementTierContainer .achievementTierContainerData .achievementTierStatus {\n    width: 80%;\n    display: flex;\n    flex-direction: column;\n}\n\n.tippy-content .achievementOverviewAchievementHolder .achievementTierContainer .achievementTierContainerData .achievementTierStatus .description,\n#achievementsOverviewList .achievementContentList.unlocks .achievementOverviewAchievementHolder .achievementTierContainer .achievementTierContainerData .achievementTierStatus .description {\n    display: flex;\n    flex: 1;\n    padding-bottom: 10px;\n}\n\n.tippy-content .achievementOverviewAchievementHolder .achievementTierContainer .achievementReward,\n#achievementsOverviewList .achievementContentList.unlocks .achievementOverviewAchievementHolder .achievementTierContainer .achievementReward {\n    width: 25%;\n    min-width: 25%;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 4px;\n    background: linear-gradient(to top, rgba(20, 29, 37, 0.8) 0%, rgba(9, 13, 18, 0.8) 100%);\n    border: 1px solid;\n    border-color: #24323D #131A20 #131A20 #131A20;\n    border-radius: 4px;\n    box-shadow: 0 0 2px 1px black, inset 0 1px 2px 1px hsl(205, 33%, 11%);\n    padding-top: 4px;\n    padding-bottom: 4px;\n}\n\n.tippy-content .achievementOverviewAchievementHolder .achievementReward .rewardTitle,\n#achievementsOverviewList .achievementContentList.unlocks .achievementOverviewAchievementHolder .achievementReward .rewardTitle {\n    font-size: 13px;\n    font-weight: bold;\n    color: white;\n}\n\n.tippy-content .achievementOverviewAchievementHolder .achievementReward .rewardDescription,\n#achievementsOverviewList .achievementContentList.unlocks .achievementOverviewAchievementHolder .achievementReward .rewardDescription {\n    color: white;\n}\n\n.tippy-content .achievementOverviewAchievementHolder .achievementReward .rewardTypeTitleContainer,\n#achievementsOverviewList .achievementContentList.unlocks .achievementOverviewAchievementHolder .achievementReward .rewardTypeTitleContainer {\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    border: 1px solid #252525;\n    border-radius: 4px;\n    background-color: #12161a;\n}\n\n.tippy-content .achievementOverviewAchievementHolder .achievementReward .rewardTypeTitle,\n#achievementsOverviewList .achievementContentList.unlocks .achievementOverviewAchievementHolder .achievementReward .rewardTypeTitle {\n    z-index: unset;\n    text-align: center;\n    text-shadow: 0px 0px 3px rgba(255, 255, 255, 0.7);\n    font-size: 10px;\n    font-weight: 700;\n    padding: 5px;\n    max-width: 100%;\n    max-height: 100%;\n    color: white;\n    overflow-wrap: anywhere;\n    hyphens: auto;\n}\n\n.tippy-content .achievementOverviewAchievementHolder .achievementTierContainer .achievementTierContainerData .unlockedContainer,\n#achievementsOverviewList .achievementContentList.unlocks .achievementOverviewAchievementHolder .achievementTierContainer .achievementTierContainerData .unlockedContainer {\n    color: #5db143;\n}\n\n.tippy-content .achievementOverviewAchievementHolder .achievementTierContainer .achievementTierContainerData .achievementProgressLabel,\n#achievementsOverviewList .achievementContentList.unlocks .achievementOverviewAchievementHolder .achievementTierContainer .achievementTierContainerData .achievementProgressLabel {\n    width: 200px;\n    text-align: center;\n}\n\nprogress.achievementProgress {\n    appearance: none;\n    height: 8px;\n    position: relative;\n    border-radius: 25px;\n    border: 1px solid #000;\n    overflow: hidden;\n    box-sizing: border-box;\n    width: 200px;\n}\n\n.progressParent {\n    display: flex;\n    width: 200px;\n    position: relative;\n}\n\n.progressParent::after {\n    position: absolute;\n    left: 0;\n    top: 0;\n    display: block;\n    width: 100%;\n    height: 100%;\n    content: \"\";\n    background: repeating-linear-gradient(90deg, #000000, #000000 1px, transparent 2px, transparent 10px);\n}\n\nprogress.progress_0 {\n    color: #bd0000;\n}\n\nprogress.progress_0::-webkit-progress-value {\n    background-color: #bd0000;\n}\n\nprogress.progress_0::-moz-progress-bar {\n    background-color: #bd0000;\n}\n\nprogress.progress_10 {\n    color: #f63a0f;\n}\n\nprogress.progress_10::-webkit-progress-value {\n    background-color: #f63a0f;\n}\n\nprogress.progress_10::-moz-progress-bar {\n    background-color: #f63a0f;\n}\n\nprogress.progress_20 {\n    color: #f54810;\n}\n\nprogress.progress_20::-webkit-progress-value {\n    background-color: #f54810;\n}\n\nprogress.progress_20::-moz-progress-bar {\n    background-color: #f54810;\n}\n\nprogress.progress_30 {\n    color: #f36311;\n}\n\nprogress.progress_30::-webkit-progress-value {\n    background-color: #f36311;\n}\n\nprogress.progress_30::-moz-progress-bar {\n    background-color: #f36311;\n}\n\nprogress.progress_40 {\n    color: #f27d14;\n}\n\nprogress.progress_40::-webkit-progress-value {\n    background-color: #f27d14;\n}\n\nprogress.progress_40::-moz-progress-bar {\n    background-color: #f27d14;\n}\n\nprogress.progress_50 {\n    color: #f2b01e;\n}\n\nprogress.progress_50::-webkit-progress-value {\n    background-color: #f2b01e;\n}\n\nprogress.progress_50::-moz-progress-bar {\n    background-color: #f2b01e;\n}\n\nprogress.progress_60 {\n    color: #f2be1d;\n}\n\nprogress.progress_60::-webkit-progress-value {\n    background-color: #f2be1d;\n}\n\nprogress.progress_60::-moz-progress-bar {\n    background-color: #f2be1d;\n}\n\nprogress.progress_70 {\n    color: #f2cc1c;\n}\n\nprogress.progress_70::-webkit-progress-value {\n    background-color: #f2cc1c;\n}\n\nprogress.progress_70::-moz-progress-bar {\n    background-color: #f2cc1c;\n}\n\nprogress.progress_80 {\n    color: #dcd61c;\n}\n\nprogress.progress_80::-webkit-progress-value {\n    background-color: #dcd61c;\n}\n\nprogress.progress_80::-moz-progress-bar {\n    background-color: #dcd61c;\n}\n\nprogress.progress_90 {\n    color: #b1db1d;\n}\n\nprogress.progress_90::-webkit-progress-value {\n    background-color: #b1db1d;\n}\n\nprogress.progress_90::-moz-progress-bar {\n    background-color: #b1db1d;\n}\n\nprogress.progress_100 {\n    color: #86e01e;\n}\n\nprogress.progress_100::-webkit-progress-value {\n    background-color: #86e01e;\n}\n\nprogress.progress_100::-moz-progress-bar {\n    background-color: #86e01e;\n}\n\n/* Space object skin selection tooltip start */\n#spaceObjectSkinSelectTooltip {\n    min-width: 260px;\n    height: 200px;\n    overflow-y: auto;\n    flex-direction: column;\n    overscroll-behavior: contain;\n}\n\n.spaceObjectSkinSelectionSpaceObjectsPerCoordinate {\n    display: flex;\n    flex-direction: row;\n}\n\n.spaceObjectSkinSelectionSpaceObjectsPerCoordinate:hover {\n    background-color: #2b2521;\n}\n\n.spaceObjectSkinSelectionCoordinatesHolder {\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    padding: 10px 5px;\n    font-size: 12px;\n    font-weight: bold;\n    color: #6F9FC8;\n    width: 60px;\n}\n\n.spaceObjectSkinSelectionSpaceObjectsHolder {\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    flex-grow: 1;\n    font-size: 15px;\n    padding-right: 5px;\n}\n\n.spaceObjectSkinSelectionSpaceObject {\n    cursor: pointer;\n    padding: 5px 0;\n    display: flex;\n    align-items: center;\n    gap: 5px;\n    color: #3a7fb4;\n    font-weight: 700;\n    text-shadow: 1px 1px 1px black, 0 0 7px hsl(200, 60%, 35%);\n    font-size: 14px;\n}\n\n.spaceObjectSkinSelectionSpaceObject:hover {\n    color: #f4f2f1;\n}\n\n/* Space object skin selection tooltip end */\n\n#achievementsoverviewcomponent gradient-button span {\n    color: #f1f1f1;\n    font-family: Verdana, Arial, SunSans-Regular, sans-serif;\n    font-size: 9px;\n    font-weight: bold;\n    padding-bottom: 3px;\n}\n#achievementsoverviewcomponent gradient-button .seasonExpiration span {\n    font-size: 16px;\n}\n#achievementsoverviewcomponent .seasonExpiration {\n    height: 30px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap:5px;\n    color: #3a7fb4;\n    font-weight: 700;\n    text-align: left;\n    text-shadow: 1px 1px 1px black, 0 0 7px hsl(200, 60%, 35%);\n    line-height: 16px;\n    font-size: 14px;\n    background-color: #590404;\n}\n\n\n/* SEASONAL SUMMARY start */\n#achievementsOverviewList .achievementContentList.unlocks .seasonalSummary {\n    width: 100%;\n    background: linear-gradient(to top, rgba(20, 29, 37, 0.8) 0%, rgba(9, 13, 18, 0.8) 100%);\n    border-radius: 3px;\n    box-shadow: 0 0 2px 1px black, inset 0 1px 2px 1px hsl(205, 33%, 11%);\n}\n\n#achievementsOverviewList .achievementContentList.unlocks .seasonalSummary .seasonalSummaryHeader {\n    display:flex;\n    height: 50px;\n    position: relative;\n}\n\n#achievementsOverviewList .achievementContentList.unlocks .seasonalSummary .seasonalSummaryHeader .togglingIconHolder {\n    display: flex;\n    width: 50px;\n    height: 50px;\n    position: absolute;\n    top: 0;\n    left: 0;\n    justify-content: center;\n    align-items: center;\n}\n\n#achievementsOverviewList .achievementContentList.unlocks .seasonalSummary .seasonalSummaryHeader .seasonalSummaryHeaderTitleAndProgress {\n    display: flex;\n    width: 100%;\n    height: 100%;\n    flex-direction: column;\n    justify-content: center;\n    align-items: center;\n}\n\n#achievementsOverviewList .achievementContentList.unlocks .seasonalSummary .seasonalSummaryHeader .seasonalSummaryHeaderTitleAndProgress .seasonalSummaryTitle {\n    text-shadow: 0px 0px 3px rgba(255, 255, 255, 0.7);\n    font-size: 14px;\n    font-weight: 700;\n    padding-bottom: 5px;\n}\n\n#achievementsOverviewList .achievementContentList.unlocks .seasonalSummary .seasonalSummaryHeader .seasonalSummarySeasonStatus {\n    position: absolute;\n    right: 0;\n    top: 0;\n    display: flex;\n    padding: 5px;\n    font-size: 8px;\n}\n\n#achievementsOverviewList .achievementContentList.unlocks .seasonalSummary .seasonalSummaryHeader .seasonalSummarySeasonStatus span.running {\n    color: #008900;\n}\n\n#achievementsOverviewList .achievementContentList.unlocks .seasonalSummary .seasonalSummaryHeader .seasonalSummarySeasonStatus span.ended {\n    color: #a11d1d;\n}\n\n#achievementsOverviewList .achievementContentList.unlocks .seasonalSummary .seasonalSummaryAchievementList {\n    display:none;\n    margin-top: 5px;\n    padding-left: 5px;\n    padding-right: 5px;\n}\n/* SEASONAL SUMMARY end */\n\n\n.progressUpdateBtn button.custom_btn  {\n    box-shadow: 0px 0.5px 1px 0.5px #0000001c !important;\n    padding-top: 2px;\n}\n.achievementProgressLabel button {\n    position: absolute;\n    top: -1px;\n    width: 20px !important;\n    height: 20px !important;\n}\n\n.adviceWrapper  {\n    float:left;\n    margin-top:10px;\n    position:relative;\n    width:100%;\n}\n\n#advice-bar {\n    text-align:center;\n    width: 130px;\n}\n\n#promotionCountdownBox { margin: 0 0 10px 0; }\n\n#advice-bar a { text-decoration:none; display: inline-block; margin: 0 auto;}\n#advice-bar a img{ border:0 none; }\n\n/* *********************** promotionCountdown Box *************************** */\ndiv#promotionCountdownBox a{\n    color: white;\n    text-decoration: none;\n    font: 11px Verdana,Arial,Helvetica,sans-serif;\n    width: 150px;\n    text-align: center;\n    background: #13181D;\n    background: #171d23; /* Old browsers */\n    background: -moz-linear-gradient(top,  #171d23 0%, #101419 100%); /* FF3.6+ */\n    background: -webkit-gradient(linear, left top, left bottom, color-stop(0%,#171d23), color-stop(100%,#101419)); /* Chrome,Safari4+ */\n    background: -webkit-linear-gradient(top,  #171d23 0%,#101419 100%); /* Chrome10+,Safari5.1+ */\n    background: -o-linear-gradient(top,  #171d23 0%,#101419 100%); /* Opera 11.10+ */\n    background: -ms-linear-gradient(top,  #171d23 0%,#101419 100%); /* IE10+ */\n    background: linear-gradient(top,  #171d23 0%,#101419 100%); /* W3C */\n    filter: progid:DXImageTransform.Microsoft.gradient( startColorstr='#171d23', endColorstr='#101419',GradientType=0 ); /* IE6-9 */\n\n    border: 1px solid #3F3D13;\n    -webkit-border-radius: 5px; /* Saf3-4, iOS 1-3.2, Android ≤1.6 */\n    -moz-border-radius: 5px; /* FF1-3.6 */\n    border-radius: 5px; /* Opera 10.5, IE9, Saf5, Chrome, FF4, iOS 4, Android 2.1+ */\n    padding: 5px;\n    display: block;\n}\n.no-touch div#promotionCountdownBox a:hover {\n    background: #1C2934;\n    background: -moz-linear-gradient(top, #1C2934 0%, #273847 100%);\n    background: -webkit-gradient(linear, left top, left bottom, color-stop(0%,#1C2934), color-stop(100%,#273847));\n    background: -webkit-linear-gradient(top, #1C2934 0%,#273847 100%);\n    background: -o-linear-gradient(top, #1C2934 0%,#273847 100%);\n    background: -ms-linear-gradient(top, #1C2934 0%,#273847 100%);\n    background: linear-gradient(top, #1C2934 0%,#273847 100%);\n    filter: progid:DXImageTransform.Microsoft.gradient( startColorstr='#1c2934', endColorstr='#273847',GradientType=0 );\n}\ndiv#promotionCountdownBox a span {\n    display: block;\n}\n\ndiv#promotionCountdownBox a.build-it {\n    position: static;\n    font-weight: bold;\n    margin: auto;\n}\n\ndiv#promotionCountdownBox a.build-it span {\n    padding-top: 12px;\n}\n\n#promotionCountdown {\n    text-align: center;\n    font-size: 20px;\n    color: gold;\n}\n\n#alliancecomponent #netz #planet {\n    background: url(//gf1.geo.gfsrv.net/cdnf8/6dafcd306b27d77508ef115722b6b0.jpg) no-repeat;\n    height: 250px;\n}\n\n#alliancecomponent #planet h2 {\n    color: #fff;\n    font: bold 18px/22px Verdana,Arial,Helvetica,sans-serif;\n    height: 22px;\n    margin: 0 0 0 144px;\n    overflow: hidden;\n    padding-top: 7px;\n    white-space: nowrap;\n    width: 470px;\n    text-overflow: ellipsis;\n}\n\n#alliancecomponent #netz #planet.shortHeader { background-image: url(\"//gf3.geo.gfsrv.net/cdn8d/29ebfe0c3f1c5000219cdd3325bed4.jpg\"); }\n\n#alliancecomponent #planet.shortHeader .toggleHeader,\n#alliancecomponent #planet .toggleHeader {\n    background: none;\n    height: 22px;\n    line-height:normal;\n    position:absolute;\n    right:5px;\n    top:5px;\n    width: 23px;\n    z-index:40;\n}\n\n#alliancecomponent #planet .toggleHeader {\n    right:13px;\n    top:8px;\n}\n\n#alliancecomponent #planet .toggleHeader {background: url(\"//gf1.geo.gfsrv.net/cdn0b/d55059f8c9bab5ebf9e8a3563f26d1.gif\") no-repeat 0 -22px;}\n\n#alliancecomponent .alliance_wrapper {\n    position: relative;\n    height: 100%;\n    min-height: 130px;\n    background:url(\"//gf1.geo.gfsrv.net/cdn03/db530b4ddcbe680361a6f837ce0dd7.gif\") repeat-y;\n    margin:0;\n    padding: 10px 0 1px 0;\n}\n\n#alliancecomponent #allyExternTextBB,\n#alliancecomponent #allyInternTextBB {\n    margin:10px 20px;\n    overflow:auto;\n    padding:5px;\n    text-align:left;\n    width:605px;\n}\n#alliancecomponent #netz #alliance #allianceContent .contentz #allyinternpage {\n    text-align: center;\n}\n#allianceclassselection {\n    margin-bottom: 0;\n    padding: 0 15px 0;\n    position: relative;\n}\n\n#allianceclassselection .content h2 {\n    color: #6F9FC8;\n    font-size: 14px;\n    font-weight: 700;\n}\n\n#allianceclassselection p {\n    padding: 10px;\n}\n\n#writeapplication .content h2 {\n    color: #6F9FC8;\n    font-size: 14px;\n    font-weight: 700;\n}\n\n#allyInternText ul > li, #allyExternTextBB ul > li {\n    width: 26px;\n    height: 26px;\n    background: url(//gf3.geo.gfsrv.net/cdneb/f5f81e8302aaad56c958c033677fb8.png) -527px -317px no-repeat;\n    display: flex;\n    align-items: center;\n    padding-left: 32px;\n    margin: 5px 0;\n}\n\n.allianceclass.boxes {\n    position: relative;\n\n    display: flex;\n    flex-direction: row;\n}\n\n.allianceclass.box {\n    position: relative;\n    box-sizing: border-box;\n\n    width:200px;\n\n    padding:20px !important;\n    margin:5px;\n\n    border-width: 1px;\n    border-style: solid;\n    border-color:#6F9FC8;\n    border-radius: 4px;\n\n    background: #0d1014;\n\n    color:#848484;\n\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: start;\n\n    transition: all 0.4s ease-in-out;\n\n    cursor: pointer;\n}\n\n.allianceclass.box:hover {\n    transform: scale(1.05);\n    z-index: 10;\n    border-color: #9ECBF3;\n}\n\n.allianceclass.box .buttons {\n    margin-bottom: 10px;\n}\n\n.allianceclass.box .sprite {\n    margin-bottom: 20px;\n}\n.allianceclass.box h2 {\n    font-size: 14px;\n    font-weight: bold;\n    color: #6F9FC8;\n    text-align: center;\n    margin-bottom: 10px;\n}\n\n.allianceclass.box .bonus {\n    position: relative;\n    width:100%;\n    text-align: left;\n    margin:5px 0 !important;\n    font-size: 11px;\n}\n\n.allianceclass.box > ul {\n    margin: 0 0 20px 10px !important;\n    width: 100%;\n}\n\n.allianceclass.box > ul > li {\n    margin-bottom: 10px;\n}\n\n.allianceclass.box .build-it.deactivate {\n    filter: hue-rotate(270deg);\n}\n\n.allianceclass.box ul li {\n    list-style: square;\n    line-height: 130%;\n}\n\n.allianceclass .shipinfo {\n    display: flex;\n    flex-direction: column;\n    width: 100%;\n}\n\n.allianceclass .pad20 {\n    padding: 20px;\n}\n\n.allianceclass .boxClassBoni {\n    flex-grow: 1;\n    margin-bottom: 10px;\n}\n\n.allianceclass .shipdescription {\n    text-align: left;\n    margin: 0 !important;\n    font-size: 9px;\n}\n.allianceclass .shipinfo .sprite {\n    margin: 7px auto;\n}\n\n#allianceclassselection #planet.header {\n    background-image: url(//gf2.geo.gfsrv.net/cdna6/7a8f00fc22aae3e3355d09de037655.jpg);\n    height: 250px;\n}\n\n#allianceclassselection #inhalt .shortCorner {top:4px;}\n\n#allianceclassselection .content {\n}\n\n#allianceclassselection .boxWrapper .content div {\n    padding: 0;\n}\n\n#allianceclassselection .content h2 {\n    color: #6F9FC8;\n    font-size: 14px;\n    font-weight: 700;\n}\n\n#allianceclassselection .header h2 {\n    color: #fff;\n    font: bold 18px/22px Verdana, Arial, Helvetica, sans-serif;\n    height: 22px;\n    margin: 0 0 0 144px;\n    overflow: hidden;\n    padding-top: 7px;\n    white-space: nowrap;\n    width: 470px;\n    text-overflow: ellipsis;\n    text-align: left;\n}\n\n#allianceclassselection p {\n    padding: 10px;\n}\n\n#allyInternText ul > li, #allyExternTextBB ul > li {\n    width: 26px;\n    height: 26px;\n    background: url(//gf3.geo.gfsrv.net/cdneb/f5f81e8302aaad56c958c033677fb8.png) -527px -317px no-repeat;\n    display: flex;\n    align-items: center;\n    padding-left: 32px;\n    margin: 5px 0;\n}\n\n/* *****************************************************************************\n   STATION: ALLYDEPOT OVERLAY\n***************************************************************************** */\n/*#station #supplydepotlayer h3,\n#station-moon #supplydepotlayer h3 {\n        float: left;\n        width: 630px;\n        padding: 6px 0 0 0;\n        font-weight: 700;\n        line-height:20px;\n        color: #6f9fc8;\n        font-size: 12px;\n        text-align: center;\n}*/\n#supplydepotlayer #inner img {\n    float:left;\n    margin-right: 5px;\n}\n\n#supplydepotlayer #inner div.content {\n    float:left;\n    margin: 0 0 0 10px;\n    width: 450px;\n}\n\n#supplydepotlayer #inner .capacity {\n    font-weight:700;\n    display:block;\n    margin-top:10px;\n}\n\n\n#supplydepotlayer #supportWrap {\n    border-collapse:collapse;\n    margin:15px 0;\n    background: rgb(17, 17, 17);\n    border-radius: 4px;\n}\n\n#supplydepotlayer #inner #supportWrap img { float:none; }\n\n#supplydepotlayer #supportWrap .textInput { text-align:center; }\n\n#supplydepotlayer #supportWrap td,\n#supplydepotlayer #supportWrap th {\n    padding: 3px 3px;\n    width:110px;\n}\n#supplydepotlayer #supportWrap th {\n    border-bottom: 1px solid #848484;\n    font-weight: 700;\n}\n#supplydepotlayer table#supportWrap span.countdown { display:none; }\n\n/*\n\tAnythingSlider v1.5.10+ Default (base) theme\n\tBy Chris Coyier: http://css-tricks.com\n\twith major improvements by Doug Neiner: http://pixelgraphics.us/\n\tbased on work by Remy Sharp: http://jqueryfordesigners.com/\n*/\n\n/******* SET DEFAULT DIMENSIONS HERE ********/\ndiv.anythingSlider {\n\tdisplay: block;\n\twidth: 475px;\n\theight: 390px;\n\tmargin: 0 auto;\n\toverflow: hidden; /* needed for Opera and Safari */\n}\n#buffBar div.anythingSlider {\n    padding: 0 15px;\n    float: right;\n    margin-right: 5px;\n}\n#buffBar li {\n    width: 532px;\n    height: 36px;\n    z-index: 7;\n    position: relative;\n}\n#buffBar li>div {\n    margin: 2px 2px 0;\n    float:left;\n    z-index: 2;\n}\n/****** SET COLORS HERE *******/\n/* Default State */\ndiv.anythingSlider .thumbNav a.cur, div.anythingSlider .thumbNav a {\n\tbackground: #34414F;\n\tcolor: #848484;\n}\n\n/* Active State */\n#shop div.anythingSlider.activeSlider .anythingWindow {\n\tborder-color: #172125;\n}\n\n#overview div.anythingSlider.activeSlider .anythingWindow {\n\tborder-color: #172125;\n}\n\ndiv.anythingSlider.activeSlider .thumbNav a.cur {\n\tbackground: #465059;\n\tcolor: #fff;\n}\n\ndiv.anythingSlider.activeSlider .thumbNav a {\n\tbackground: #172123;\n}\n\n/**** DO NOT CHANGE BELOW THIS LINE ****/\n/* anythingSlider viewport window */\ndiv.anythingSlider .anythingWindow {\n\toverflow: hidden;\n\tposition: relative;\n\twidth: 100%;\n\theight: 100%;\n}\n/* wrapper: 45px right & left padding for the arrows, 28px @ bottom for navigation */\ndiv.anythingSlider {\n\tposition: relative;\n\tpadding: 0 35px 28px 35px;\n}\n.active_item_slider div.anythingSlider { padding: 0 31px 25px 29px; }\n\n/* anythingSlider base */\n.anythingBase {\n\tbackground: transparent;\n\tlist-style: none;\n\tposition: absolute;\n\ttop: 0;\n\tleft: 0;\n\tmargin: 0;\n\tpadding: 0;\n}\n.anythingBase .panel {\n\tbackground: transparent;\n\tdisplay: block;\n\toverflow: hidden;\n\tfloat: left;\n\tpadding: 0;\n\tmargin: 0;\n}\n\n/* Navigation Arrows */\ndiv.anythingSlider .arrow {\n\tbackground: none;\n\ttop: 50%;\n\tposition: absolute;\n\tdisplay: block;\n}\ndiv.anythingSlider .arrow a {\n\tbackground: url(\"//gf3.geo.gfsrv.net/cdnb5/f49f4260ff20f815d0a6470ed55ad3.png\") no-repeat;\n\tdisplay: block;\n\theight: 180px;\n\tmargin: -90px 0 0 0; /* half height of image */\n\twidth: 30px;\n\ttext-align: center;\n\toutline: 0;\n}\n#buffBar div.anythingSlider .arrow a {\n    height: 44px;\n    width: 12px;\n    margin: -26px 0 0;\n    cursor: pointer;\n}\n.active_item_slider div.anythingSlider .arrow a {\n\theight: 135px;\n\tmargin: -85px 0 0 0;\n\twidth: 25px;\n}\ndiv.anythingSlider .arrow a span { display: block; text-indent: -9999px; }\ndiv.anythingSlider .forward { right: 0; }\ndiv.anythingSlider .back { left: 0; }\ndiv.anythingSlider .forward a { background-position: -120px 0; }\ndiv.anythingSlider .back a { background-position: -30px 0; }\n#buffBar div.anythingSlider .forward a { background-position: -151px -263px; }\n#buffBar div.anythingSlider .back a { background-position: -107px -263px; }\n.active_item_slider div.anythingSlider .forward a { background-position: -120px -310px; }\n.active_item_slider div.anythingSlider .back a { background-position: -30px -310px; }\n\n.no-touch div.anythingSlider .forward a:hover,\ndiv.anythingSlider .forward a.hover { background-position: -150px 0; }\n.no-touch div.anythingSlider .back a:hover,\ndiv.anythingSlider .back a.hover { background-position: 0 0; }\n#buffBar .no-touch .forward a:hover,\n#buffBar div.anythingSlider .forward a.hover { background-position: -166px -263px; }\n#buffBar .no-touch .back a:hover,\n#buffBar div.anythingSlider .back a.hover { background-position: -92px -263px; }\n.no-touch .active_item_slider div.anythingSlider .forward a:hover,\n.active_item_slider div.anythingSlider .forward a.hover { background-position: -150px -310px; }\n.no-touch .active_item_slider div.anythingSlider .back a:hover,\n.active_item_slider div.anythingSlider .back a.hover { background-position: 0 -310px; }\n\ndiv.anythingSlider .disabled a { cursor: default; } \ndiv.anythingSlider .forward.disabled a,\n.no-touch div.anythingSlider .forward.disabled a:hover,\ndiv.anythingSlider .forward.disabled a.hover { background-position: -90px 0; }\ndiv.anythingSlider .back.disabled a,\n.no-touch div.anythingSlider .back.disabled a:hover,\ndiv.anythingSlider .back.disabled a.hover { background-position: -60px 0; }\n#buffBar div.anythingSlider .forward.disabled a,\n#buffBar .no-touch div.anythingSlider .forward.disabled a:hover,\n#buffBar div.anythingSlider .forward.disabled a.hover { background-position: -136px -263px; }\n#buffBar div.anythingSlider .back.disabled a,\n#buffBar .no-touch div.anythingSlider .back.disabled a:hover,\n#buffBar div.anythingSlider .back.disabled a.hover { background-position: -122px -263px; }\n.active_item_slider div.anythingSlider .forward.disabled a,\n.no-touch .active_item_slider div.anythingSlider .forward.disabled a:hover,\n.active_item_slider div.anythingSlider .forward.disabled a.hover { background-position: -90px -310px; }\n.active_item_slider div.anythingSlider .back.disabled a,\n.no-touch .active_item_slider div.anythingSlider .back.disabled a:hover,\n.active_item_slider div.anythingSlider .back.disabled a.hover { background-position: -60px -310px; }\n\n/* Navigation Links */\ndiv.anythingSlider .anythingControls { \n    outline: 0; \n    display: none; \n    top: 0;\n}\n\ndiv.anythingSlider .thumbNav { margin: 0; padding: 0; text-align: left;}\ndiv.anythingSlider .thumbNav li { display: inline; }\ndiv.anythingSlider .thumbNav a {\n    display: inline-block;\n    text-decoration: none;\n    padding: 3px 8px 1px 8px;\n    height: 18px;\n    margin: 5px 3px;\n    background: #172123;\n    text-align: center;\n    outline: 0;\n\n      -webkit-box-shadow: 1px 1px 2px #000; /* Saf3-4, iOS 4.0.2 - 4.2, Android 2.3+ */\n    -moz-box-shadow: 1px 1px 2px #000; /* FF3.5 - 3.6 */\n      box-shadow: 1px 1px 2px #000; /* Opera 10.5, IE9, FF4+, Chrome 6+, iOS 5 */\n\n    -webkit-border-radius: 3px; /* Saf3-4, iOS 1-3.2, Android ≤1.6 */\n    -moz-border-radius: 3px; /* FF1-3.6 */\n    border-radius: 3px; /* Opera 10.5, IE9, Saf5, Chrome, FF4, iOS 4, Android 2.1+ */\n    -moz-background-clip: padding; -webkit-background-clip: padding-box; background-clip: padding-box;\n}\n/* for active_item_slider on overview */\n.active_item_slider div.anythingSlider .thumbNav span { display: none; }\n.active_item_slider div.anythingSlider a {\n    height: 16px;\n    padding: 0;\n    width: 16px;\n}\n\n\n/* slider autoplay right-to-left, reverse order of nav links to look better */\ndiv.anythingSlider.rtl .thumbNav a { float: right; } /* reverse order of nav links */\ndiv.anythingSlider.rtl .thumbNav { float: left; }    /* move nav link group to left */\ndiv.anythingSlider.rtl .anythingWindow {\n\tdirection: ltr;\n\tunicode-bidi: bidi-override;\n}\n\n.shopPaginator {\n\tdisplay: flex;\n\tjustify-content: center;\n\tposition: relative;\n\tbottom: 26px;\n}\n\n.shopPaginator button {\n\tbackground: #34414f;\n\tcolor: #848484;\n\tdisplay: inline-block;\n\ttext-decoration: none;\n\tpadding: 3px 8px 1px 8px;\n\theight: 20px;\n\tmargin: 5px 3px;\n}\n\n.shopPaginator button:focus {\n\tbackground: #465059;\n\tcolor: #fff;\n}\n\n.shopPages:focus {\n\tbackground: #465059;\n\tcolor: #fff;\n}\n\n.shopPages  {\n\twidth: 200px;\n\tdisplay: flex;\n\tjustify-content: center;\n}\n\n.panelShop .panelBuff {\n\tdisplay: flex;\n}\n\n.shopPaginator .buffPaginator {\n    display: flex;\n    justify-content: center;\n    position: relative;\n    bottom: 26px;\n}\n\n.shopPaginator button  {\n    background: #34414f;\n    color: #848484;\n    display: inline-block;\n    text-decoration: none;\n    padding: 3px 8px 1px 8px;\n    height: 20px;\n    margin: 5px 3px;\n}\n\n.buffPaginator {\n    display: flex;\n    position: absolute;\n    top: 196px;\n}\n\n.buffPaginator button {\n    background: #34414f;\n    color: #848484;\n    display: flex;\n    text-decoration: none;\n    padding: 3px 8px 1px 8px;\n    height: 20px;\n    width: 0;\n    margin: 5px 3px;\n    border-radius: 5px;\n    justify-content: center;\n}\n\n#activeBuffDetails .buffPaginator button.arrowPrev,\n#activeBuffDetails .buffPaginator button.arrowNext {\n    padding: 1.3px 8px 1px 8px;\n}\n\n.shopPaginator button:focus  .buffPaginator button:focus {\n    background: #465059;\n    color: #fff;\n}\n\n.shopPages:focus .buffPages:focus {\n    background: #465059;\n    color: #fff;\n}\n\n.shopPages .buffPages {\n    width: 250px;\n    display: flex;\n    justify-content: center;\n}\n\n.panelShop  {\n    display: flex;\n}\n\n.panelBuff {\n    display: flex;\n    flex-direction: row ;\n}\n\n#buffBar .buttonPrev {\n    left: 35px;\n    z-index: 5;\n}\n\n#buffBar .buttonNext {\n    left: 585px;\n}\n\n#buffBar .buttonPrev, #buffBar .buttonNext {\n\tz-index: 5;\n\tposition: absolute;\n\tcursor: pointer;\n}\n\n.pagination-controls button {\n    background: none;\n    color: #848484;\n    font-size: 30px;\n}\n\n.arrowNext {\n    position: relative;\n}\n\n\n#artifactshop header {\n    position: relative;\n    width: 654px;\n    height: 300px;\n    margin: 0 auto 8px;\n}\n\n#artifactshop header::after {\n    position: absolute;\n    left: -8px;\n    bottom: -2px;\n    width: 670px;\n    height: 39px;\n    background: url(\"//gf3.geo.gfsrv.net/cdn8b/e7a3f8489bd4c9c45d14851020c656.gif\") bottom left no-repeat, url(\"//gf2.geo.gfsrv.net/cdnd8/7c3b7bb7038a638e9c122542398514.gif\") bottom right no-repeat ;\n    content: \"\";\n}\n\n#artifactshop header h2 {\n    position: absolute;\n    left: 144px;\n    top: 7px;\n    font: bold 18px/22px Verdana,Arial,Helvetica,sans-serif;\n    color: #fff;\n}\n\n#artifactshop #artifactShopContent {\n    position: relative;\n    box-sizing: border-box;\n    width: 654px;\n    border: 2px solid #000;\n    margin: 0 auto 7px;\n    padding: 0 5px;\n    background: #0d1014;\n}\n\n#artifactshop #artifactShopContent::before,\n#artifactshop #artifactShopContent::after {\n    pointer-events: none;\n}\n\n#artifactshop #artifactShopContent::before {\n    position: absolute;\n    left: -9px;\n    top: -3px;\n    width: 668px;\n    height: 28px;\n    background: url(\"//gf3.geo.gfsrv.net/cdn53/f333e15eb738b8ec692340f507e1ae.png\") bottom left no-repeat, url(\"//gf2.geo.gfsrv.net/cdnd5/66551209db14e23b3001901b996cc6.png\") bottom right no-repeat;\n    content: \"\";\n}\n\n#artifactshop #artifactShopContent::after {\n    position: absolute;\n    left: -9px;\n    bottom: -4px;\n    width: 668px;\n    height: 50px;\n    background: url(\"//gf3.geo.gfsrv.net/cdnea/0330abcdca0d125d35a0ebace4b584.png\") bottom left no-repeat, url(\"//gf1.geo.gfsrv.net/cdn9b/8003a40825bc96919c5fec01b018b8.png\") bottom right no-repeat;\n    content: \"\";\n}\n\n#artifactshop #artifactShopContent h3 {\n    position: relative;\n    width: 100%;\n    margin: -2px 0 5px;\n    background: url(\"//gf1.geo.gfsrv.net/cdnfb/a4e7913209228ebaf2297429aeb87b.png\");\n    color: #6f9fc8;\n    font: bold 12px/27px Verdana,Arial,Helvetica,sans-serif;\n    text-align: center;\n}\n\n#artifactshop #artifactShopContent h3::before,\n#artifactshop #artifactShopContent h3::after {\n    position: absolute;\n    top: 0;\n    width: 26px;\n    height: 27px;\n    content: \"\";\n}\n\n#artifactshop #artifactShopContent h3::before {\n    left: -5px;\n    background: url(\"//gf2.geo.gfsrv.net/cdn4a/127bd495b9325216af08a588ecc540.png\");\n}\n\n#artifactshop #artifactShopContent h3::after {\n    right: -5px;\n    background: url(\"//gf2.geo.gfsrv.net/cdn1d/80db96934a5b82ce002f839cd85a44.png\");\n}\n\n#artifactshop #artifactShopContent #artifactInfoPanel {\n    display: flex;\n    width: 100%;\n    height: 70px;\n}\n\n#artifactshop #artifactShopContent #artifactInfoPanel > div {\n    display: flex;\n    flex: 1;\n    background: -webkit-linear-gradient(top, #171d23 0%, #101419 100%);\n    border-style: solid;\n    border-width: thin;\n    border-color: #3f5c75;\n    border-right: 0;\n    flex-direction: column;\n    justify-content: center;\n    align-items: center;\n    gap: 5px;\n}\n\n#artifactshop #artifactShopContent #artifactInfoPanel > div#remainingTime > span {\n    text-align: center;\n}\n\n#artifactshop #artifactShopContent #artifactInfoPanel > div#remainingTime > time {\n    color: #6f9fc8;\n    font: 12px Verdana, Arial, Helvetica, sans-serif;\n}\n\n#artifactshop #artifactShopContent #artifactInfoPanel .infoIcon {\n    position: absolute;\n    margin-left: 180px;\n    margin-bottom: 40px;\n    font-size: 25px;\n    color: #7c92a5d6;\n    cursor: pointer;\n}\n\n#artifactshop #artifactShopContent #artifactInfoPanel > div:first-child {\n    border-radius: 5px 0 0 5px;\n}\n\n#artifactshop #artifactShopContent #artifactInfoPanel > div:last-child {\n    border-radius: 0 5px 5px 0;\n    border-right: solid;\n    border-width: thin;\n    border-color: #3f5c75;\n}\n\n#artifactshop #artifactShopContent #artifactInfoPanel > div span {\n    color: #6f9fc8;\n    font: 12px Verdana,Arial,Helvetica,sans-serif;\n}\n\n#artifactshop #artifactShopContent #artifactInfoPanel > div span#discoveryAmountSpan {\n    margin-top: 10px;\n}\n\n#artifactshop #artifactShopContent #artifactInfoPanel > div span.withBonus {\n    color: #D43635;\n}\n\n#artifactshop #artifactShopTierContent {\n    display: flex;\n    flex-direction: column;\n    width: 100%;\n    height: 100%;\n    align-items: center;\n}\n\n#artifactshop #artifactShopTierContent tier-header {\n    font: 20px Verdana, Arial, Helvetica, sans-serif;\n    font-weight: bold;\n    padding: 10px;\n}\n\n#artifactshop #artifactShopTierContent #artifactShopAdditionalInfo {\n    font: 10px Verdana, Arial, Helvetica, sans-serif;\n    color: #848484;\n    display: flex;\n    flex-direction: column;\n    align-items: stretch;\n    align-content: center;\n    flex-wrap: wrap;\n    margin-top: 20px;\n    margin-bottom: 20px;\n}\n\n#artifactshop #artifactShopTierContent tier-items {\n    display: flex;\n    width: 100%;\n    height: 220px !important;\n    background: linear-gradient(to bottom, #1f2630 0%, #111921 100%);\n}\n\n#artifactshop #artifactShopTierContent tier-items > standard-items {\n    display: flex;\n    flex: 3;\n}\n\n#artifactshop #artifactShopTierContent tier-items > bonus-items {\n    display: flex;\n    flex: 1;\n}\n\n#artifactshop #artifactShopTierContent div#tierSlider {\n    height: 180px;\n}\n\n#artifactshop #artifactShopTierContent .anythingSlider {\n    padding-bottom: 0;\n    height: 220px !important;\n}\n\n#artifactshop #artifactShopTierContent tier-items purchase-button gradient-button {\n    width: 120px;\n    height: 34px;\n}\n\n#artifactshop #artifactShopTierContent tier-items purchase-button {\n    width: 120px;\n    height: 34px;\n}\n\n#artifactshop #artifactShopTierContent tier-items purchase-button#inactiveButton button,\n#artifactshop #artifactShopTierContent tier-items purchase-button#notEnoughArtifactsButton button {\n    cursor: not-allowed;\n}\n\n#artifactshop #artifactShopTierContent tier-items purchase-button#inactiveButton button {\n    border: 1px solid #999999 !important;\n    opacity: 0.3;\n}\n\n#artifactshop #artifactShopTierContent tier-items non-button.itemClaimed {\n    color: green;\n    width: 120px;\n    height: 36px;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    font-size: 20px;\n}\n\n#artifactshop #artifactShopTierContent tier-items non-button {\n    width: 120px;\n    height: 36px;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    font-size: 20px;\n\n    &.itemClaimed {\n        color: #9c0;\n    }\n\n    &.itemNotClaimed {\n        color: grey;\n        opacity: 50%;\n    }\n}\n\n#artifactshop #artifactShopTierContent tier-items purchase-button gradient-button .commandingStaffBonus {\n    border: 1px outset #ff9600 !important;\n    background: linear-gradient(160deg, #dd8301 0%, #b76d00 33%, #673b00 66%, #000000 100%);\n    color: antiquewhite;\n}\n\n#artifactshop #artifactShopTierContent tier-items purchase-button gradient-button .commandingStaffBonus:hover {\n    filter: brightness(120%);\n}\n\n#artifactshop #artifactShopTierContent .tierHolder {\n    width: 100%;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n}\n\n#artifactshop #artifactShopTierContent .tierHolder tier-items-header {\n    display: flex;\n    width: 570px;\n}\n\n#artifactshop #artifactShopTierContent .tierItemHolder {\n    flex: 1;\n    display: flex;\n    justify-content: center;\n    padding: 5px;\n    flex-direction: column;\n    align-items: center;\n    gap: 10px;\n}\n\n#artifactshop #artifactShopTierContent .tierItemHolder .tierItemName {\n    font: 11px Verdana, Arial, Helvetica, sans-serif;\n    text-align: center;\n    color: #bdbbbb;\n    overflow-wrap: anywhere;\n    hyphens: auto;\n    height: 39px;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n}\n\n#artifactshop #artifactShopTierContent standard-items .tierItemHolder:first-child,\n#artifactshop #artifactShopTierContent standard-items .tierItemHolder:nth-child(3n + 1),\n#artifactshop #artifactShopTierContent bonus-items .tierItemHolder:first-child {\n    border-left: 2px solid;\n    border-color: #2b3341;\n}\n\n#artifactshop #artifactShopTierContent bonus-items,\n#artifactshop #artifactShopTierContent standard-items {\n    border: 2px solid;\n    border-left: 0;\n    border-color: #2b3341;\n}\n\n#artifactshop #artifactShopTierContent standard-items:has(+ bonus-items) {\n    border-right: 0px;\n}\n\n\n#artifactshop #artifactShopTierContent .tierItemHolder:nth-child(n+5) {\n    border-top: 0;\n}\n\n#artifactshop #artifactShopTierContent .tierItemHeaderHolder {\n    flex: 3;\n    align-items: center;\n    display: flex;\n    justify-content: center;\n    font: 12px Verdana,Arial,Helvetica,sans-serif;\n    color: #9c0;\n    border: 2px solid;\n    border-right: 0;\n    border-bottom: 0;\n    border-color: #2b3341;\n    border-radius: 5px 5px 0 0;\n    padding: 2px;\n    background: #bfff0014;\n    text-align: center;\n}\n\n#artifactshop #artifactShopTierContent .tierItemHeaderHolder:last-child {\n    border-right: 2px solid;\n    border-color: #2b3341;\n}\n\n#artifactshop #artifactShopTierContent .tierItemHeaderHolder.commandingStaffBonus {\n    flex: 1;\n    color: #cc8600;\n    background: #ff830017;\n    padding: 0;\n}\n\n#artifactshop #artifactShopTierContent .tierItemHeaderHolder.commandingStaffBonus > span {\n    padding: 2px;\n}\n\n#artifactshop #artifactShopTierContent .item_img {\n    cursor: pointer;\n    width: 105px;\n    height: 105px;\n    background-position: center;\n    background-repeat: no-repeat;\n    background-size: 100px 100px;\n}\n\n#artifactshop #artifactShopTierContent .item_img .ecke {\n    color: #FF9600;\n    position: absolute;\n    bottom: 0;\n    right: 0;\n    width: 72px;\n    text-align: right;\n    display: flex;\n    justify-content: flex-end;\n}\n\n#artifactshop #artifactShopTierContent .r_common .item_img_box {\n    background-position: -210px 0;\n}\n\n#artifactshop #artifactShopTierContent .r_epic .item_img_box {\n    background-position: -420px 0;\n}\n\n#artifactshop #artifactShopTierContent .item_img_box {\n    background: url(//gf1.geo.gfsrv.net/cdn05/40c2de12da5e952a18570b71e7a081.png) no-repeat 0 0;\n    height: 105px;\n    width: 105px;\n    margin: 0 0 2px;\n    position: relative;\n    z-index: 10;\n}\n\n#artifactshop gradient-button .smallFont {\n    font-size: 12px !important;\n}\n\n#artifactshop #artifactShopTierContent tier-scrollbar {\n    width: 80%;\n    height: 60px;\n    overflow-x: scroll;\n    display: flex;\n    flex-direction: row;\n    align-items: center;\n    scrollbar-width: none;\n    scroll-behavior: smooth;\n    user-select: none;\n\n    tier {\n        display: flex;\n        flex-direction: column;\n        width: 50px;\n        min-width: 50px;\n        justify-content: center;\n        align-content: center;\n        align-items: center;\n        gap: 5px;\n\n        &:hover {\n            cursor: pointer;\n        }\n\n        tier-content {\n            display: flex;\n            align-items: center;\n            width: 100%;\n            height: 100%;\n\n            .tierClaimed &,\n            .tierInProgress & {\n                animation: pulse 3.5s infinite;\n            }\n\n            left {\n                display: flex;\n                content: \" \";\n                height: 2px;\n                width: 30%;\n                background: #39546de8;\n                justify-content: center;\n                flex-direction: row;\n                align-items: center;\n                align-content: stretch;\n                flex-wrap: wrap;\n\n                .tierClaimed & {\n                    background-color: darkgreen;\n                }\n\n                .tierInProgress & {\n                    background: linear-gradient(90deg,rgba(0, 100, 0, 1) 1%, rgba(153, 153, 48, 1) 100%);\n                }\n            }\n\n            middle {\n                display: flex;\n                width: 30px;\n                aspect-ratio: 1 / 1;\n                border: 2px solid #39546de8 !important;\n                border-radius: 50%;\n                box-sizing: border-box;\n                text-align: center;\n                -webkit-appearance: none;\n                box-shadow: hsla(0,0%,100%,.15) 0 1px 1px, inset hsla(0,0%,0%,.5) 0 0 0 1px;\n                background-color: hsla(0,0%,0%,.2);\n                background-image: -webkit-radial-gradient( hsla(200,100%,90%,1) 0%, hsla(200,100%,70%,1) 15%, hsla(200,100%,60%,.3) 28%, hsla(200,100%,30%,0) 70% );\n                background-repeat: no-repeat;\n                -webkit-transition: background-position .15s cubic-bezier(.8, 0, 1, 1),\n                -webkit-transform .25s cubic-bezier(.8, 0, 1, 1);\n                outline: none;\n\n                .tierClaimed & {\n                    border-color: darkgreen !important;\n                    background-color: rgba(0, 100, 0, 0.1);\n                }\n\n                .tierInProgress & {\n                    border-color: #999930 !important;\n                    background-color: rgba(153, 153, 48, 0.1);\n                }\n\n                &.selectedTier {\n                    -webkit-transition: background-position .2s .15s cubic-bezier(0, 0, .2, 1),\n                    -webkit-transform .25s cubic-bezier(0, 0, .2, 1);\n                    background-position: 0 0;\n                }\n\n                &.selectedOnLeft {\n                    background-position: -24px 0;\n                }\n\n                &.selectedOnRight {\n                    background-position: 24px 0;\n                }\n\n                &.selectedTier ~ &.selectedOnLeft{\n                    background-position: 24px 0;\n                }\n\n                &.selectedTier ~ &.selectedOnLeft{\n                    background-position: -24px 0;\n                }\n            }\n\n            &:hover > middle {\n                transform: scale(1.2);\n            }\n\n            right {\n                display: flex;\n                content: \" \";\n                height: 2px;\n                width: 30%;\n                background: #39546de8;\n                justify-content: center;\n                flex-direction: row;\n                align-items: center;\n                align-content: stretch;\n                flex-wrap: wrap;\n\n                .tierClaimed & {\n                    background: linear-gradient(90deg, darkgreen 1%, #39546de8 100%);\n                }\n\n                .tierInProgress & {\n                    background: linear-gradient(90deg,rgba(153, 153, 48, 1) 1%, #39546de8 100%);\n                }\n            }\n\n            empty {\n                display: flex;\n                width: 30%;\n                height: 2px;\n            }\n        }\n\n        tier-title {\n            font-size: 9px;\n            overflow-wrap: break-word;\n            hyphens: auto;\n            text-align: center;\n        }\n    }\n\n    tier.tierInProgress + tier.tierInProgress {\n        tier-content left {\n            background: rgba(153, 153, 48, 1);\n        }\n    }\n\n    tier.tierClaimed:has(+ tier.tierClaimed) {\n        tier-content right {\n            background: darkgreen;\n        }\n    }\n\n    tier.tierClaimed:has(+ tier.tierInProgress) {\n        tier-content right {\n            background: darkgreen;\n        }\n    }\n\n    tier.tierInProgress:has(+ tier.tierInProgress) {\n        tier-content right {\n            background: rgba(153, 153, 48, 1);\n        }\n    }\n\n    tier.tierInProgress:has(+ tier.tierClaimed) {\n        tier-content right {\n            background: linear-gradient(90deg,rgba(153, 153, 48, 1) 1%, darkgreen 100%);\n        }\n    }\n\n}\n\n@keyframes pulse {\n    0% {\n        filter: brightness(100%);\n    }\n\n    50% {\n        filter: brightness(130%);\n    }\n\n    100% {\n        filter: brightness(100%);\n    }\n}\n\n#artifactshop #artifactShopTierContent #tierScrollbarHolder {\n    margin-top: 20px;\n    width: 100%;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    flex-direction: row;\n}\n\n#artifactshop #artifactShopTierContent .tierScrollbarBefore {\n    cursor: pointer;\n    user-select: none;\n    font-size: 45px;\n    margin-right: 10px;\n    margin-bottom: 15px;\n    opacity: 30%;\n}\n\n#artifactshop #artifactShopTierContent .tierScrollbarAfter {\n    cursor: pointer;\n    user-select: none;\n    font-size: 45px;\n    margin-left: 10px;\n    margin-bottom: 15px;\n    opacity: 30%;\n}\n\n\n.timeIndicator {\n    font-size: 13px;\n   display: contents;\n\n}\n\n#planetbarcomponent.fleft #bannerskyscrapercomponent {\n    margin-left: 150px;\n    position: absolute;\n    display: flex;\n    align-items: flex-end;\n}\ndiv#banner_skyscraper a.close_details {\n    position: relative;\n    display: flex;\n    align-items: flex-end;\n}\ndiv#banner_skyscraper a.close_details {\n    display: flex;\n    position: absolute;\n    margin-top: 0;\n    justify-content: flex-end;\n    z-index: 2;\n}\ndiv#banner_skyscraper a {\n    display: block;\n}\ndiv#banner_skyscraper .bannerPosition {\n    position: relative;\n    display: flex;\n    justify-content: flex-end;\n}\n\n/* -------------------------------------------------------------------\n// markItUp! Universal MarkUp Engine, JQuery plugin\n// By Jay Salvat - http://markitup.jaysalvat.com/\n// ------------------------------------------------------------------*/\n.markItUp * {\n    margin:0; padding:0;\n    outline:none;\n}\n\n.markItUp  { width: auto; }\n\n.markItUpHeader {\n    overflow: visible;\n    text-align: left;\n    position: relative;\n    z-index: 1;\n}\n\n.markItUpEditor {\n    box-sizing: border-box;\n    clear:both;\n    font:12px 'Courier New', Courier, monospace;\n    height: 100px;\n    line-height:18px;\n    margin: 5px 0 0 0;\n    min-height: 100px;\n    overflow:auto;\n    padding:5px;\n    width:100%;\n}\n\n/* ******* for displaying the preview div ********* */\n.miu_footer { margin: 0 0 10px 0; }\n.miu_preview_container\t{\n    background-color: #263240;\n    border-radius: 3px;\n    box-sizing: border-box;\n    margin: 0 0 10px 0;\n    min-height: 20px;\n    overflow: auto;\n    padding: 5px;\n    width: 100%;\n}\n.miu_preview_container ul > li {\n    display: flex;\n    align-items: center;\n    padding-left: 32px;\n    margin: 5px 0;\n    pointer-events: none;\n}\n.markItUp .preview_link:visited,\n.no-touch .markItUp .preview_link:hover,\n.markItUp .preview_link:active,\n.markItUp .preview_link { /*background: none;*/ }\n\n.sendComment .preview_link,\n.markItUp .preview_link {\n    font-size: 11px;\n    font-weight: 700;\n}\n\n.markItUpFooter { width:100%; }\n\n.markItUpResizeHandle {\n    /*background-image:url(\"/cdn/img/markitup/handle.png\");*/\n    cursor:n-resize;\n    height:5px;\n    margin-left:auto;\n    margin-right:auto;\n    overflow:hidden;\n    width:22px;\n}\n/***************************************************************************************/\n/* first row of buttons */\n.markItUpHeader ul li\t{\n    list-style:none;\n    display: inline-block;\n}\n\n.markItUpHeader ul .markItUpDropMenu {\n    background-position: -497px -342px;\n    padding-right: 15px;\n    position: relative;\n    width: 40px;\n    z-index: 2;\n}\n.no-touch .markItUpHeader ul .markItUpDropMenu:hover,\n.markItUpHeader ul .markItUpDropMenu:active { background-position: -440px -342px; }\n\n.markItUpHeader ul .dropdown_arr {\n    display: inline-block;\n    width: 12px;\n    height: 10px;\n    background: url(\"//gf1.geo.gfsrv.net/cdnf3/0b1f53b6226809a4aa178872fb76c0.png\") no-repeat;\n    position: absolute;\n    top: 7px;\n    right: 2px;\n}\n.markItUpHeader ul .markItUpDropMenu li {\n    margin-right:0;\n    width: auto;\n}\n\n/* next rows of buttons */\n.markItUpHeader ul ul {\n    display:none;\n    position:absolute;\n    top: 24px;\n    background: #181F26;\n    border: 1px solid black;\n    right: 0;\n    width: auto;\n    z-index: 3;\n    height: 250px;\n    overflow-y: scroll;\n    -webkit-overflow-scrolling: touch;\n}\n.markItUpHeader ul ul li,\n.no-touch .markItUpHeader ul ul li:hover,\n.markItUpHeader ul ul li:active {\n    background: none;\n    display: block;\n    white-space: nowrap;\n    margin: 0;\n    padding: 3px;\n    line-height: 17px;\n\n}\n.no-touch .markItUpHeader ul ul li:hover,\n.markItUpHeader ul ul li:active { background: #2E3842; }\n\n.markItUpHeader ul ul a { background: none; }\n\n.markItUpHeader ul .markItUpSeparator {\n    background: #1A2031;\n    color: #1A2031;\n    height: 24px;\n    margin: 5px 0 0 -2px;\n    width: 2px;\n}\n.no-touch .markItUpHeader ul .markItUpSeparator:hover,\n.markItUpHeader ul .markItUpSeparator:active {\n    background: #1A2031;\n    color: #1A2031;\n}\n\n.markItUpHeader ul ul .markItUpSeparator {\n    width:auto; height:1px;\n    margin:0;\n}\n/* next rows of buttons */\n.markItUpHeader ul ul ul {\n    position:absolute;\n    top:-1px; left:150px;\n}\n.markItUpHeader ul a {\n    display:block;\n    width:16px;\n    height:16px;\n    text-indent:-10000px;\n    background-repeat:no-repeat;\n}\n.markItUpHeader ul ul a,\n.markItUpHeader ul ul a:link {\n    display:block;\n    padding-left:0;\n    text-indent:0;\n    width: auto;\n    padding: 2px 6px 2px 3px;\n    background: none;\n    text-decoration: none;\n}\n.no-touch .markItUpHeader ul ul a:hover  {\n    color:#FFF !important;\n    background:none;\n    text-decoration: none !important;\n}\n\n\n\n/* -------------------------------------------------------------------\n// markItUp!\n// By Jay Salvat - http://markitup.jaysalvat.com/\n// ------------------------------------------------------------------*/\n\n.markItUp li {\n    width:26px;\n    height:26px;\n    background: url(\"//gf3.geo.gfsrv.net/cdneb/f5f81e8302aaad56c958c033677fb8.png\") -527px -317px no-repeat;\n    margin: 0 3px 5px 2px;\n}\n\n.markItUp .li_miu_advanced {\n    background: none;\n    width: auto;\n}\n.markItUp  .show_miu_advanced,\n.markItUp  .hide_miu_advanced {\n    color: #fff;\n    display: block;\n    margin: 10px 0 0 0;\n}\n\n.markItUp  .show_miu_advanced:before { content: '[+] '; }\n.markItUp  .hide_miu_advanced:before { content: '[-] '; }\n\n.markItUp .toggle_miu_advanced {\n    cursor: pointer;\n}\n\n.no-touch .markItUp .toggle_miu_advanced:hover,\n.markItUp .toggle_miu_advanced:active { text-decoration: underline; }\n\n.markItUp .miu_basic,\n.markItUp .miu_advanced { margin: 0 0 0 -2px; }\n\n.markItUp .miu_advanced { border-top: 1px solid #26303C; }\n\n.no-touch .markItUp li:hover,\n.markItUp li:active { background-position: -500px -317px; }\n