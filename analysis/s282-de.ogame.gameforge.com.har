\\"Nein\\\",\\\"ok\\\":\\\"OK\\\",\\\"attention\\\":\\\"Achtung\\\",\\\"outlawWarning\\\":\\\"Du bist im Begriff, einen st\\\\u00e4rkeren Spieler anzugreifen. Wenn du dies tust, wird dein Angriffsschutz f\\\\u00fcr 7 Tage ausgesetzt und alle Spieler k\\\\u00f6nnen dich straflos angreifen. Bist du dir sicher, dass du fortfahren m\\\\u00f6chtest?\\\",\\\"lastSlotWarningMoon\\\":\\\"Dieses Geb\\\\u00e4ude wird den letzten Bauplatz verbrauchen. Baue deine Mondbasis aus, um weitere Pl\\\\u00e4tze zu bekommen.\\\\nM\\\\u00f6chtest du das Geb\\\\u00e4ude wirklich bauen?\\\",\\\"lastSlotWarningPlanet\\\":\\\"Dieses Geb\\\\u00e4ude wird den letzten Bauplatz verbrauchen. Baue deinen Terraformer aus oder kaufe ein Planetenfelditem, um weitere Pl\\\\u00e4tze zu bekommen.\\\\nM\\\\u00f6chtest du das Geb\\\\u00e4ude wirklich bauen?\\\",\\\"forcedVacationWarning\\\":\\\"Best\\\\u00e4tige jetzt deinen Lobby-Account und wir schenken dir in jedem Universum Dunkle Materie!\\\",\\\"planetMoveBreakUpWarning\\\":\\\"Vorsicht! Dieser Auftrag k\\\\u00f6nnte \\\\u00fcber den Umsiedlungszeitpunkt hinaus laufen und einen Abbruch der Umsiedlung zur Folge haben. Willst du wirklich mit dem Auftrag fortfahren?\\\",\\\"moreDetails\\\":\\\"Mehr Details\\\",\\\"lessDetails\\\":\\\"Weniger Details\\\",\\\"planetOrder\\\":{\\\"lock\\\":\\\"Sortierung sperren\\\",\\\"unlock\\\":\\\"Sortierung entsperren\\\"},\\\"darkMatter\\\":\\\"Dunkle Materie\\\",\\\"errorNotEnoughDM\\\":\\\"Es ist nicht gen\\\\u00fcgend Dunkle Materie vorhanden! M\\\\u00f6chtest du diese jetzt kaufen?\\\",\\\"activateItem\\\":{\\\"upgradeItemQuestion\\\":\\\"M\\\\u00f6chtest du dein vorhandenes Item wirklich ersetzen? Der alte Bonus geht dabei verloren.\\\",\\\"upgradeItemQuestionHeader\\\":\\\"Item ersetzen?\\\"},\\\"characterClassItem\\\":{\\\"buyAndActivateItemQuestion\\\":\\\"Willst du die Klasse #characterClassName# f\\\\u00fcr #darkmatter# Dunkle Materie aktivieren? Deine aktuelle Klasse geht dabei verloren.\\\",\\\"activateItemQuestion\\\":\\\"Willst du die Klasse #characterClassName# aktivieren? Deine aktuelle Klasse geht dabei verloren.\\\"},\\\"allianceClassItem\\\":{\\\"buyAndActivateItemQuestion\\\":\\\"Willst du die Allianzklasse #allianceClassName# f\\\\u00fcr #darkmatter# Dunkle Materie aktivieren? Die aktuelle Allianzklasse geht dabei verloren.\\\",\\\"activateItemQuestion\\\":\\\"Willst du die Allianzklasse #allianceClassName# aktivieren? Die aktuelle Allianzklasse geht dabei verloren.\\\",\\\"appendCurrentClassQuestion\\\":\\\"<br><br>Aktuelle Allianzklasse: #currentAllianceClassName#<br><br>Zuletzt ge\\\\u00e4ndert am: #lastAllianceClassChange#\\\"},\\\"scrapperOfferItem\\\":{\\\"buyAndActivateItemQuestion\\\":\\\"M\\\\u00f6chtest du dieses Angebot f\\\\u00fcr #darkmatter# Dunkle Materie aktivieren? Dein momentanes Angebot beim Schrotth\\\\u00e4ndler wird dadurch \\\\u00fcberschrieben.\\\",\\\"activateItemQuestion\\\":\\\"M\\\\u00f6chtest du dieses Angebot aktivieren? Dein momentanes Angebot beim Schrotth\\\\u00e4ndler wird dadurch \\\\u00fcberschrieben.\\\"},\\\"LOCA_ALL_NETWORK_ATTENTION\\\":\\\"Achtung\\\",\\\"LOCA_ALL_YES\\\":\\\"Ja\\\",\\\"LOCA_ALL_NO\\\":\\\"Nein\\\",\\\"redirectMessage\\\":\\\"Mit diesem Link verl\\\\u00e4sst du OGame. Willst du fortfahren?\\\"};\\n  $(\\\"a.icon_link.recallFleet\\\").click(function (e) {\\n      e.preventDefault();\\n      var fleetId = $(this).attr(\\\"data-fleet-id\\\");\\n      errorBoxDecision(\\n          \\\"R\\u00fcckruf\\\",\\n          \\\"Flotte zur\\u00fcckrufen\\\",\\n          \\\"Ja\\\",\\n          \\\"Nein\\\",\\n          function() {\\n              $.post(ajaxRecallFleetURI, {fleetId: fleetId, token: token}, (response) => {\\n                  let data = JSON.parse(response)\\n                  token = data.newAjaxToken\\n\\n                  if (data.success) {\\n                      let currentUrl = window.location.href\\n                      let params = new URLSearchParams(currentUrl)\\n                     