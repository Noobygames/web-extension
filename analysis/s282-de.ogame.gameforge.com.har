ilecomponent .mainRS .moreInfoHolder .profileEntry .profileValue.highscoreValue .change.point:before {\n    content: '\\2013';\n    width: 10px;\n    height: 14px;\n    font-size: 10px;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n}\n\n#playerprofilecomponent .mainRS .profileHolder .profilePageInfo .profileEntry .profileValue.highscoreValue .change.arrowUp:before,\n#playerprofilecomponent .mainRS .moreInfoHolder .profileEntry .profileValue.highscoreValue .change.arrowUp:before {\n    content: '\\1F845';\n    width: 10px;\n    height: 14px;\n    font-size: 14px;\n    color: green;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n}\n\n#playerprofilecomponent .mainRS .profileHolder .profilePageInfo .profileEntry .profileValue.highscoreValue .change.arrowDown:before,\n#playerprofilecomponent .mainRS .moreInfoHolder .profileEntry .profileValue.highscoreValue .change.arrowDown:before {\n    content: '\\1F847';\n    width: 10px;\n    height: 14px;\n    font-size: 14px;\n    color: red;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n}\n\n#playerprofilecomponent .editHolder .profileTag {\n    background: #fefefe;\n    border-radius: 4px;\n    padding: 4px;\n    box-sizing: border-box;\n    cursor: pointer;\n    z-index: 99999;\n    height: 100%;\n    border: 1px outset #696666 !important;\n    background: linear-gradient(160deg, rgba(54, 77, 99, 1) 0%, rgba(40, 57, 72, 1) 33%, rgba(20, 30, 38, 1) 66%, rgba(18, 26, 33, 1) 100%);\n    box-shadow: 0 2px 3px 1px #0000008c;\n    outline: none;\n    transition: 300ms;\n    margin: 4px;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    color: #f1f1f1;\n    font-family: Verdana, Arial, SunSans-Regular, sans-serif;\n    font-size: 9px;\n    font-weight: bold;\n}\n\n#playerprofilecomponent .editHolder .profileTag.active,\n#playerprofilecomponent .profileEntry .playerTitle gradient-button button.custom_btn.active {\n